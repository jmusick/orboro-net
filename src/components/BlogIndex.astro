---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "./PostCard.astro";
import SidebarLayout from "./SidebarLayout.astro";
import Sidebar from "./Sidebar.astro";
import Button from "./Button.astro";
import { blogHref, type BlogPage } from "../lib/blog-listing";
import type { CategoryWithCount, PostSummary } from "../lib/content";

// Shared by /blog (page 1) and /blog/page/[page]. Pure server rendering: search,
// sort and paging are plain GET links and a GET form, so everything works without JS.
interface Props {
  listing: BlogPage;
  categories: CategoryWithCount[];
  recent: PostSummary[];
}
const { listing, categories, recent } = Astro.props;
const { posts, page, total, totalPages, filters, pageSize } = listing;
const formatDate = (value: number) => new Date(value).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const recentPosts = recent.map((post) => ({ slug: post.slug, title: post.title, dateLabel: formatDate(post.publishedAt ?? post.createdAt) }));
const isFiltered = filters.q !== "" || filters.sort !== "newest";
const first = (page - 1) * pageSize + 1;
const last = first + posts.length - 1;
const title = page > 1 ? `Blog, Page ${page} | Orboro.net` : "Blog | Orboro.net";
const BLOG_DESCRIPTION = "Articles on World of Warcraft Mythic+ and gearing, ARPG leagues and seasons, GPU settings, and criticism of gaming-community talking points.";
const description = page > 1 ? `${BLOG_DESCRIPTION} Page ${page} of ${totalPages}.` : BLOG_DESCRIPTION;
const noun = (n: number) => (n === 1 ? "post" : "posts");
const sorts = [
  ["newest", "Newest first"],
  ["oldest", "Oldest first"],
  ["title-asc", "Title A–Z"],
  ["title-desc", "Title Z–A"],
];
// Window of page links: first, last, and two either side of the current page.
const pageNumbers: (number | null)[] = [];
for (let n = 1; n <= totalPages; n++) {
  if (n === 1 || n === totalPages || Math.abs(n - page) <= 2) pageNumbers.push(n);
  else if (pageNumbers[pageNumbers.length - 1] !== null) pageNumbers.push(null);
}
---

<BaseLayout title={title} description={description}>
  <section class="blog-header">
    <h1>Blog</h1>
    <p class="subtitle">Guides, analysis, and opinion on World of Warcraft, Path of Exile 2, and other games.</p>
  </section>

  {total === 0 && !isFiltered ? (
    <div class="empty-state">
      <p>No posts published yet.</p>
    </div>
  ) : (
    <SidebarLayout>
      <section id="blog-root">
        <form class="blog-controls" method="get" action="/blog" role="search">
          <input
            id="blog-search"
            class="ui-control blog-search"
            type="search"
            name="q"
            value={filters.q}
            maxlength="100"
            placeholder="Search posts…"
            aria-label="Search posts"
            autocomplete="off"
          />
          <div class="sort-wrap">
            <label for="blog-sort">Sort</label>
            <select id="blog-sort" name="sort" class="ui-control blog-sort">
              {sorts.map(([value, label]) => <option value={value} selected={value === filters.sort}>{label}</option>)}
            </select>
          </div>
          <Button type="submit" variant="secondary" size="sm">Apply</Button>
          {isFiltered && <Button href="/blog" variant="tertiary" size="sm">Clear</Button>}
          <span id="blog-count" class="blog-count" role="status">
            {total === 0 ? "0 posts" : `Showing ${first}–${last} of ${total} ${noun(total)}`}
          </span>
        </form>

        {posts.length === 0 ? (
          <p class="empty-state">No posts match your search.</p>
        ) : (
          <div id="blog-grid" class="posts-grid">
            {posts.map((post) => (
              <PostCard title={post.title} slug={post.slug} image={post.featuredImageUrl}
                dateIso={new Date(post.date).toISOString()} dateLabel={formatDate(post.date)}
                categories={post.categories} excerpt={post.excerpt} />
            ))}
          </div>
        )}

        {totalPages > 1 && (
          <nav class="pagination" aria-label="Blog pages">
            {page > 1 && <Button href={blogHref(page - 1, filters)} rel="prev" variant="tertiary" size="sm" icon="chevron-left">Newer</Button>}
            <ul class="pagination__pages">
              {pageNumbers.map((n) => n === null ? (
                <li aria-hidden="true" class="pagination__gap">…</li>
              ) : (
                <li>
                  <Button href={blogHref(n, filters)} variant={n === page ? "secondary" : "tertiary"} size="sm"
                    aria-current={n === page ? "page" : undefined} aria-label={`Page ${n}`}>{n}</Button>
                </li>
              ))}
            </ul>
            {page < totalPages && <Button href={blogHref(page + 1, filters)} rel="next" variant="tertiary" size="sm" icon="chevron-right" iconPosition="right">Older</Button>}
          </nav>
        )}
      </section>
      <Sidebar slot="sidebar" categories={categories} recentPosts={recentPosts} />
    </SidebarLayout>
  )}
</BaseLayout>

<style>
  .blog-header {
    margin-bottom: 2rem;
  }

  .blog-header h1 {
    margin-top: 0;
  }

  .subtitle {
    font-size: 1.1rem;
    color: var(--muted);
    margin: 0;
  }

  .blog-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .blog-search {
    flex: 1;
    min-width: 200px;

  }

  .blog-search:focus {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--accent);

  }

  .sort-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .blog-sort {

    cursor: pointer;

  }

  .blog-sort:focus {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-color: var(--accent);

  }

  .blog-count {
    font-size: 0.82rem;
    color: var(--muted);
    white-space: nowrap;
    margin-left: auto;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }


  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .pagination__pages {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pagination__gap {
    color: var(--muted);
  }

  .empty-state {
    text-align: center;
    padding: 2rem;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .blog-controls {
      flex-direction: column;
      align-items: stretch;
    }

    .blog-count {
      margin-left: 0;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
