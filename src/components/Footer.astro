---
import Icon from "./Icon.astro";
import packageJson from "../../package.json";
import { PATREON_URL, profiles } from "../lib/profiles";

interface Props {
  /** Top-level navigation, repeated under Explore. */
  links?: { label: string; url: string }[];
}
const { links = [] } = Astro.props;
const year = new Date().getFullYear();
const version = packageJson.version;
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="/images/logo-480.png" alt="Orboro.net" width="480" height="115" loading="lazy" />
        <p>Gaming guides, analysis and developer resources by JD. Independent and reader-supported.</p>
        <a class="footer-support" href={PATREON_URL} target="_blank" rel="noopener noreferrer"><Icon name="patreon" size={14} filled />Support on Patreon</a>
      </div>
      <div class="footer-cols">
        <nav class="footer-col" aria-labelledby="footer-explore">
          <h2 id="footer-explore">Explore</h2>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/blog">Blog</a></li>
            {links.map((link) => <li><a href={link.url}>{link.label}</a></li>)}
          </ul>
        </nav>
        <section class="footer-col" aria-labelledby="footer-profiles">
          <h2 id="footer-profiles">Find me elsewhere</h2>
          <ul>
            {profiles.map((profile) => (
              <li>
                {profile.url ? (
                  <a class="footer-profile" href={profile.url} target="_blank" rel="noopener noreferrer">
                    <Icon name={profile.icon} size={15} filled />{profile.platform}
                  </a>
                ) : (
                  <span class="footer-profile">
                    <Icon name={profile.icon} size={15} filled />{profile.platform}
                    <span class="footer-handle">{profile.handle}</span>
                  </span>
                )}
              </li>
            ))}
          </ul>
        </section>
        <nav class="footer-col" aria-labelledby="footer-site">
          <h2 id="footer-site">Site</h2>
          <ul>
            <li><a href="/rss.xml">RSS</a></li>
            <li><a href="/privacy-policy">Privacy policy</a></li>
            <li><button type="button" data-analytics-preferences hidden>Cookie preferences</button></li>
            <li><a href="https://github.com/jmusick/orboro-net" target="_blank" rel="noopener">Source</a></li>
            <li><a href="/admin">Admin</a></li>
          </ul>
        </nav>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {year} Orboro.net. All rights reserved.</span>
      <span class="version">v{version}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-deep);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.95rem;
  }

  .footer-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-16) var(--gutter) var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-10);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 24rem;
  }

  .footer-brand img {
    width: auto;
    height: 30px;
  }

  .footer-brand p {
    margin: 0;
  }

  .footer-support {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 1.25rem;
    border-radius: var(--r-pill,999px);
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    text-decoration: none;
    transition: background 0.18s ease;
  }

  .footer-support:hover {
    background: var(--accent-hover);
  }

  .footer-cols {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-10) clamp(2rem, 5vw, 4.5rem);
  }

  .footer-col h2 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-col li {
    margin: 0;
  }

  .footer-col a,
  .footer-col button,
  .footer-profile {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-col button {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  .footer-col button[hidden] { display: none; }
  .footer-col li:has(> button[hidden]) { display: none; }

  .footer-col a:hover,
  .footer-col button:hover {
    color: var(--text);
  }

  .footer-handle {
    color: var(--muted);
    opacity: 0.75;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
  }

  .version {
    opacity: 0.6;
  }
</style>
