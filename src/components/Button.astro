---
import Icon from './Icon.astro';

interface Props {
  href?: string;
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'tertiary' | 'ghost' | 'danger';
  size?: 'sm' | 'md' | 'lg';
  icon?: string;
  iconPosition?: 'left' | 'right';
  class?: string;
  [key: string]: any;
}

const {
  href,
  disabled = false,
  type = 'button',
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'left',
  class: className = '',
  ...rest
} = Astro.props;

const Element = href ? 'a' : 'button';
const elementProps = href
  ? { href: disabled ? undefined : href, "aria-disabled": disabled || undefined, role: disabled ? "link" as const : undefined }
  : { type, disabled };
---

<Element
  class={`btn btn--${variant} btn--${size} ${className}`}
  {...elementProps}
  {...rest}
>
  {icon && iconPosition === 'left' && (
    <span class="btn__icon">
      <Icon name={icon} size={size === 'sm' ? 16 : size === 'lg' ? 20 : 18} />
    </span>
  )}
  <slot />
  {icon && iconPosition === 'right' && (
    <span class="btn__icon">
      <Icon name={icon} size={size === 'sm' ? 16 : size === 'lg' ? 20 : 18} />
    </span>
  )}
</Element>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    border: 1px solid transparent;
    border-radius: var(--r-md,10px);
    font-weight: 500;
    cursor: pointer;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
    text-decoration: none;
    white-space: nowrap;
    font-family: var(--font-ui);
    font-size: inherit;
  }

  .btn--sm {
    border-radius: var(--r-sm);
    padding: 0.4rem 0.8rem;
    font-size: 0.875rem;
  }

  .btn--md {
    padding: 0.6rem 1rem;
    font-size: 1rem;
  }

  .btn--lg {
    min-height: 52px;
    padding: 0 1.6rem;
    font-size: 1.05rem;
  }

  /* Primary Button */
  .btn--primary {
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
  }

  .btn--primary:hover:not(:disabled):not([aria-disabled="true"]) {
    background: var(--accent-hover);
  }

  /* Secondary Button */
  .btn--secondary {
    background: var(--surface-2);
    color: var(--accent);
    border: 1px solid var(--accent);
  }

  .btn--secondary:hover:not(:disabled):not([aria-disabled="true"]) {
    background: rgb(from var(--accent) r g b / 10%);
  }

  /* Tertiary Button */
  .btn--tertiary {
    background: transparent;
    color: var(--accent);
    border: 1px solid transparent;
  }

  .btn--tertiary:hover:not(:disabled):not([aria-disabled="true"]) {
    border-color: var(--accent);
  }

  /* Ghost Button: a quiet companion to a primary action, legible over artwork. */
  .btn--ghost {
    background: rgb(from var(--bg) r g b / 45%);
    color: var(--text);
    border: 1px solid rgb(255 255 255 / 22%);
    font-weight: 600;
  }
  .btn--ghost:hover:not(:disabled):not([aria-disabled="true"]) {
    border-color: rgb(255 255 255 / 45%);
  }
  /* Danger Button */
  .btn--danger {
    background: var(--surface);
    border-color: var(--danger);
    color: var(--danger);

  }

  .btn--danger:hover:not(:disabled):not([aria-disabled="true"]) {
    background: rgb(from var(--danger) r g b / 12%);
  }

  .btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn:disabled, .btn[aria-disabled="true"] { opacity: 0.5; cursor: default; }

  /* Focus state */
  .btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
