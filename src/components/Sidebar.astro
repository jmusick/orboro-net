---
import type { CategoryWithCount } from "../lib/content";

interface RecentPost {
  slug: string;
  title: string;
  dateLabel: string;
}

interface Props {
  categories: CategoryWithCount[];
  /** Leave empty where the page already lists recent posts. */
  recentPosts?: RecentPost[];
  activeCategorySlug?: string;
}

const { categories, recentPosts = [], activeCategorySlug } = Astro.props;
// Profiles live in the site footer, so the sidebar carries only navigation.
---

<aside class="site-sidebar">
  {categories.length > 0 && (
    <nav class="sidebar-block" aria-labelledby="sidebar-categories">
      <h2 id="sidebar-categories">Categories</h2>
      <ul class="sidebar-list">
        {categories.map((cat) => (
          <li>
            <a
              class="sidebar-row"
              href={`/blog/category/${cat.slug}`}
              aria-current={cat.slug === activeCategorySlug ? "page" : undefined}
            >
              <span class="sidebar-row__text">{cat.name}</span>
              <span class="sidebar-row__count">{cat.postCount}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  {recentPosts.length > 0 && (
    <nav class="sidebar-block" aria-labelledby="sidebar-recent">
      <h2 id="sidebar-recent">Recent posts</h2>
      <ul class="sidebar-list">
        {recentPosts.map((post) => (
          <li>
            <a class="sidebar-row sidebar-row--post" href={`/blog/${post.slug}`}>
              <span class="sidebar-row__title">{post.title}</span>
              <span class="sidebar-row__date">{post.dateLabel}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</aside>

<style>
  .site-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .sidebar-block h2 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 700;
  }

  .sidebar-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sidebar-list li {
    margin: 0;
  }

  .sidebar-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 40px;
    padding: 0.45rem 0.75rem;
    border-radius: var(--r-md,10px);
    color: var(--text-soft);
    text-decoration: none;
    font-size: 0.95rem;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .sidebar-row:hover {
    background: var(--surface);
    color: #fff;
  }

  .sidebar-row[aria-current="page"] {
    background: rgb(from var(--accent) r g b / 10%);
    color: var(--accent);
    font-weight: 600;
  }

  .sidebar-row__text {
    flex: 1;
    min-width: 0;
  }

  .sidebar-row__count {
    flex-shrink: 0;
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .sidebar-row--post {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
  }

  .sidebar-row__title {
    font-weight: 600;
    line-height: 1.35;
  }

  .sidebar-row__date {
    color: var(--muted);
    font-size: 0.8rem;
  }
</style>
