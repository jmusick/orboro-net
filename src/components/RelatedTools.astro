---
import type { FeaturedTool } from "../lib/content";
import { toolDescription } from "../lib/excerpt";
import type { GameHub } from "../lib/topics";
interface Props { groups: { hub: GameHub; tools: FeaturedTool[] }[]; }
const { groups } = Astro.props;
// A compact take on the homepage toolkit tiles: title and one line, no artwork.
const shown = groups.map(({ hub, tools }) => ({ hub, tools: tools.map((tool) => ({ ...tool, description: toolDescription(tool) })) }));
---
{shown.length > 0 && (
  <section class="related-tools" aria-labelledby="related-tools-title">
    <h2 id="related-tools-title">Related tools</h2>
    {shown.map(({ hub, tools }) => (
      <div class="tool-group" data-tone={hub.tone}>
        {tools.length > 0 && (
          <ul class="tool-grid">
            {tools.map((tool) => (
              <li>
                <a class="tool" href={`/pages/${tool.slug}`}>
                  <span class="tool__game">{hub.title}</span>
                  <span class="tool__title">{tool.title}</span>
                  {tool.description && <span class="tool__desc">{tool.description}</span>}
                </a>
              </li>
            ))}
          </ul>
        )}
        <a class="tool-group__hub" href={hub.href}>All {hub.title} tools</a>
      </div>
    ))}
  </section>
)}
<style>
  .related-tools { display: flex; flex-direction: column; gap: var(--space-6); }
  .related-tools h2 { margin: 0; font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); }

  .tool-group { --tone: var(--accent); display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); }
  .tool-group[data-tone="wow"] { --tone: var(--game-wow); }
  .tool-group[data-tone="poe"] { --tone: var(--game-poe); }

  .tool-grid { align-self: stretch; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 16.5rem), 1fr)); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .tool-grid li { margin: 0; display: flex; }

  .tool {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    padding: 1rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md,10px);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }
  .tool:hover { border-color: var(--line-strong); }
  .tool:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .tool__game { color: var(--tone); font-size: 0.85rem; font-weight: 700; }
  .tool__title { font-family: var(--font-display); font-size: 1rem; font-weight: 600; line-height: 1.3; }
  .tool__desc { overflow: hidden; color: var(--muted); font-size: 0.95rem; white-space: nowrap; text-overflow: ellipsis; }

  .tool-group__hub { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; text-decoration: none; transition: color var(--transition-fast); }
  .tool-group__hub:hover { color: var(--accent-hover); }
</style>
