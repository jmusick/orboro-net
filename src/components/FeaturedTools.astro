---
import type { ContentRecord } from "../lib/content";
import { groupToolPages } from "../lib/tools";
import ToolTile from "./ToolTile.astro";
interface Props { pages: ContentRecord[]; }
const { pages } = Astro.props;
// Groups keep their order (WoW, PoE 2, other); each tile carries its game as a chip.
const tiles = groupToolPages(pages).flatMap(entry => entry.tiles);
---
{tiles.length > 0 && (
  <section class="toolkit" aria-labelledby="tools-title">
    <div class="section-head">
      <div class="section-head__row">
        <h2 id="tools-title">Your toolkit</h2>
        <a class="section-link" href="/tools">See all tools</a>
      </div>
      <p>Simulators, cheat sheets and analysis, each dated so you can see how fresh it is.</p>
    </div>
    <ul class="tile-grid" data-count={tiles.length}>
      {tiles.map(tile => (
        <li><ToolTile tile={tile} /></li>
      ))}
    </ul>
  </section>
)}
<style>
  /* Section head styles are shared in global.css. */
  /* Five tiles in the shared auto-fill grid wrap 4 + 1 once it reaches four
     columns (about 1116px wide). Keep them 3 + 2 there, and one row of five once
     each tile can still be about 15rem wide. */
  .toolkit { container-type: inline-size; }
  @container (min-width: 1116px) {
    .tile-grid[data-count="5"] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @container (min-width: 1300px) {
    .tile-grid[data-count="5"] { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }
</style>
