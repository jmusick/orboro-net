---
import "../styles/tokens.css";
import "../styles/primitives.css";
import "../styles/forms.css";
import Footer from "../components/Footer.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import Icon from "../components/Icon.astro";
import { listNavItems } from "../lib/content";
import { jsonForHtml } from "../lib/json";
import { ClientRouter } from "astro:transitions";
// Self-hosted so the CSP's `font-src 'self'` holds — no Google Fonts request.
import "@fontsource-variable/schibsted-grotesk";
import "@fontsource-variable/source-sans-3";
import "@fontsource-variable/source-sans-3/wght-italic.css";
import "highlight.js/styles/github-dark.css";

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  structuredData?: Record<string, unknown>;
  analytics?: boolean;
}

const { title, description = "", ogType = "website", ogImage: ogImageProp, ogImageAlt, ogImageWidth, ogImageHeight, structuredData, analytics = true } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://orboro.net').href;
const siteOrigin = (Astro.site ?? new URL('https://orboro.net')).origin;
// Default social card is 1200x630 (built by scripts/build-brand-images.mjs). Its
// dimensions are only emitted when it is the selected image; a page's own artwork
// emits width/height only if the caller knows them.
const ogImage = ogImageProp || `${siteOrigin}/images/social-default.png`;
const usingDefaultOg = !ogImageProp;
const ogWidth = usingDefaultOg ? 1200 : ogImageWidth;
const ogHeight = usingDefaultOg ? 630 : ogImageHeight;
const ogAlt = usingDefaultOg ? "Orboro.net logo on a dark indigo background" : ogImageAlt;
const navItems = await listNavItems(Astro.locals);
const pathname = new URL(Astro.request.url).pathname;
const nonce = Astro.locals.nonce;
const hasHeaderFeature = Astro.slots.has("headerFeature");

// Build nav tree (unlimited depth)
type NavNode = (typeof navItems)[0] & { children: NavNode[] };

function buildNavTree(items: typeof navItems, parentId: string | null = null): NavNode[] {
  return items
    .filter(i => (i.parentItemId ?? null) === parentId)
    .sort((a, b) => a.sortOrder - b.sortOrder)
    .map(i => ({ ...i, children: buildNavTree(items, i.id) }));
}

function esc(s: string) {
  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function renderDropdownItems(nodes: NavNode[]): string {
  return nodes.map(node => {
    const active = isActive(node.url) ? ' active' : '';
    if (node.children.length > 0) {
      const flyoutId = `nav-flyout-${node.id}`;
      return `<div class="nav-flyout-item">` +
        `<a href="${esc(node.url)}" class="nav-dropdown-link${active}">${esc(node.label)} <span class="nav-flyout-arrow" aria-hidden="true"></span></a>` +
        `<button type="button" class="nav-caret" aria-label="Toggle ${esc(node.label)} submenu" aria-expanded="false" aria-controls="${flyoutId}"></button>` +
        `<div class="nav-flyout" id="${flyoutId}">${renderDropdownItems(node.children)}</div>` +
        `</div>`;
    }
    return `<a href="${esc(node.url)}" class="nav-dropdown-link${active}">${esc(node.label)}</a>`;
  }).join('');
}

const navTree = buildNavTree(navItems);

function isActive(url: string): boolean {
  if (url === "/") return pathname === "/";
  return pathname === url || pathname.startsWith(url + "/");
}

function nodeIcon(node: NavNode): string {
  if (node.url.includes("about")) return "user";
  if (node.children.length > 0) return "compass";
  return "file-text";
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Orboro.net RSS Feed" href="/rss.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Orboro.net" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    {ogWidth && ogHeight && <meta property="og:image:width" content={String(ogWidth)} />}
    {ogWidth && ogHeight && <meta property="og:image:height" content={String(ogHeight)} />}
    {ogAlt && <meta property="og:image:alt" content={ogAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    {ogAlt && <meta name="twitter:image:alt" content={ogAlt} />}
    {structuredData && (
      <script type="application/ld+json" set:html={jsonForHtml(structuredData)} />
    )}
    <ClientRouter />
    <script id="csp-navigation" is:inline nonce={nonce}>
      (function () {
        if (window.orboroCspNavigation) return;
        window.orboroCspNavigation = true;
        // The original document's response policy remains active after a swap.
        // Only reconcile tags already nonced by our server; never authorize
        // unnonced author HTML or inline style attributes.
        var activeNonce = document.currentScript.nonce;
        document.addEventListener('astro:before-swap', function (event) {
          if (!('newDocument' in event) || !(event.newDocument instanceof Document)) return;
          event.newDocument.querySelectorAll('script[nonce], style[nonce]').forEach(function (element) {
            if (element.nonce || element.getAttribute('nonce')) element.setAttribute('nonce', activeNonce);
          });
        });
        document.addEventListener('astro:after-swap', function () {
          // Astro copies script attributes when executing swapped scripts.
          // Browsers hide connected nonce attribute values, so preserve the
          // nonce property ourselves for server-authorized inline scripts.
          document.querySelectorAll('script[nonce]:not([data-astro-exec])').forEach(function (script) {
            var type = script.getAttribute('type');
            if (script.src || (type && type !== 'text/javascript')) return;
            if (script.nonce !== activeNonce) return;
            var replacement = document.createElement('script');
            Array.from(script.attributes).forEach(function (attr) {
              if (attr.name !== 'nonce') replacement.setAttribute(attr.name, attr.value);
            });
            replacement.textContent = script.textContent;
            replacement.nonce = activeNonce;
            replacement.dataset.astroExec = '';
            script.replaceWith(replacement);
          });
        });
      })();
    </script>
    <style is:global>
      body {
        margin: 0;
        font-family: var(--font-ui);
        font-size: 1.0625rem;
        color: var(--text);
        /* One faint nebula behind the header, echoing the header art. */
        background:
          radial-gradient(ellipse 70% 45% at 30% 0%, rgb(76 70 170 / 22%) 0%, transparent 100%),
          var(--bg);
        background-repeat: no-repeat;
        background-attachment: fixed;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: var(--accent);
        text-underline-offset: 2px;
      }
      .skip-link {
        position: absolute;
        top: -3rem;
        left: 1rem;
        z-index: 100;
        padding: 0.6rem 1.1rem;
        background: var(--surface);
        color: var(--text);
        border: 1px solid var(--accent);
        border-radius: var(--r-md,10px);
        text-decoration: none;
        transition: top 0.15s ease;
      }
      .skip-link:focus {
        top: 1rem;
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }
      .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 1.2rem 1.2rem;
      }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 1.5rem 0;
      }
      .header-logo {
        display: block;
        flex-shrink: 0;
        text-decoration: none;
        line-height: 0;
      }
      .header-logo img {
        width: 240px;
        height: auto;
      }
      .nav-toggle {
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 4px;
        width: 42px;
        height: 38px;
        background: var(--surface);
        border: 1px solid var(--line-strong);
        border-radius: var(--r-md,10px);
        cursor: pointer;
        flex-shrink: 0;
      }
      .nav-toggle-bar {
        display: block;
        width: 20px;
        height: 2px;
        background: var(--text);
        border-radius: 1px;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }
      .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
      }
      .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
        opacity: 0;
      }
      .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
      }
      #site-nav {
        display: flex;
        align-items: stretch;
        gap: 0;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-md,10px);
        padding: 0.25rem;
        flex-wrap: wrap;
      }
      #site-nav a {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        border-radius: var(--r-sm,6px);
        padding: 0.55rem 1.35rem;
        text-decoration: none;
        transition: color 0.18s ease, background 0.18s ease;
        font-weight: 500;
        font-size: 0.95rem;
        color: var(--muted);
        white-space: nowrap;
      }
      #site-nav a:hover {
        color: var(--text);
        background: rgb(255 255 255 / 5%);
      }
      #site-nav a.active {
        color: var(--accent);
        background: rgb(from var(--accent) r g b / 10%);
      }
      .nav-dropdown-wrapper {
        position: relative;
        display: flex;
        align-items: stretch;
      }
      /* A parent link and its caret read as one item: the link gives up its
         right padding and radius, the caret picks them up, and both share
         the hover and active fill. */
      #site-nav .nav-dropdown-wrapper > a {
        padding-right: 0.2rem;
        border-radius: var(--r-sm,6px) 0 0 var(--r-sm,6px);
      }
      #site-nav .nav-dropdown-wrapper:hover > a,
      .nav-dropdown-wrapper:hover > .nav-caret {
        color: var(--text);
        background: rgb(255 255 255 / 5%);
      }
      #site-nav .nav-dropdown-wrapper > a.active,
      .nav-dropdown-wrapper > a.active + .nav-caret {
        color: var(--accent);
        background: rgb(from var(--accent) r g b / 10%);
      }
      .nav-dropdown-wrapper > a::after {
        content: none;
      }
      .nav-dropdown {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        flex-direction: column;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-md,10px);
        padding: 0.25rem;
        min-width: 180px;
        z-index: 50;
        box-shadow: 0 8px 24px rgb(0 0 0 / 45%);
      }
      .nav-caret {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        min-width: 1.9rem;
        padding: 0 0.85rem 0 0.35rem;
        background: transparent;
        border: 0;
        border-radius: 0 var(--r-sm,6px) var(--r-sm,6px) 0;
        color: var(--muted);
        cursor: pointer;
        transition: background 0.18s ease, color 0.18s ease;
      }
      .nav-caret[aria-expanded="true"] {
        color: var(--accent);
      }
      /* A thin chevron (two borders of a rotated square), pointing down;
         it flips up while its menu is open. */
      .nav-caret::after {
        content: "";
        width: 0.4rem;
        height: 0.4rem;
        border-right: 1.5px solid currentColor;
        border-bottom: 1.5px solid currentColor;
        transform: translateY(-0.12rem) rotate(45deg);
        transition: transform 0.18s ease;
      }
      .nav-caret[aria-expanded="true"]::after {
        transform: translateY(0.12rem) rotate(-135deg);
      }
      .nav-dropdown-wrapper.open > .nav-dropdown,
      .nav-flyout-item.open > .nav-flyout {
        display: flex;
      }
      .nav-dropdown a, .nav-dropdown-link {
        padding: 0.5rem 1rem;
        font-size: 0.9rem;
        border-radius: var(--r-sm,6px);
        box-shadow: none;
        display: block;
        text-decoration: none;
        color: var(--text);
        white-space: nowrap;
        transition: background 0.15s ease, color 0.15s ease;
      }
      .nav-dropdown a:hover, .nav-dropdown-link:hover {
        background: rgb(from var(--accent) r g b / 10%);
        color: var(--accent);
      }
      .nav-dropdown a.active, .nav-dropdown-link.active {
        color: var(--accent);
        background: rgb(from var(--accent) r g b / 10%);
      }
      .nav-flyout-item {
        position: relative;
        display: flex;
        align-items: stretch;
      }
      .nav-flyout-item > .nav-dropdown-link {
        display: flex;
        align-items: center;
        flex: 1;
        gap: 0.5rem;
      }
      .nav-flyout-item > .nav-dropdown-link {
        padding-right: 0.25rem;
        border-radius: var(--r-sm,6px) 0 0 var(--r-sm,6px);
      }
      .nav-flyout-item > .nav-caret {
        padding: 0 0.75rem 0 0.4rem;
      }
      .nav-flyout-item:hover > .nav-dropdown-link,
      .nav-flyout-item:hover > .nav-caret {
        color: var(--accent);
        background: rgb(from var(--accent) r g b / 10%);
      }
      /* Flyouts open to the left on desktop, so their chevron points left
         and flips to point right while open, mirroring the top tier's
         down/up flip. */
      .nav-flyout-item > .nav-caret::after {
        transform: translateX(0.12rem) rotate(135deg);
      }
      .nav-flyout-item > .nav-caret[aria-expanded="true"]::after {
        transform: translateX(-0.12rem) rotate(-45deg);
      }
      .nav-flyout-arrow {
        display: none;
      }
      .nav-flyout {
        display: none;
        position: absolute;
        top: 0;
        left: auto;
        right: 100%;
        flex-direction: column;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-md,10px);
        padding: 0.25rem;
        min-width: 180px;
        z-index: 51;
        box-shadow: 0 8px 24px rgb(0 0 0 / 45%);
      }
      main {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-lg,16px);
        padding: 2rem;
      }
      main:focus {
        outline: none;
      }
      main.main-with-feature { background: transparent; border: 0; padding: 0; }
      .main-panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 2rem; }
      @media (max-width: 768px) { .main-panel { padding: 1.5rem; } }
      section + section {
        margin-top: 2.5rem;
      }
      footer {
        /* styles moved to Footer.astro */
      }
      ul {
        padding-left: 1.2rem;
      }
      ul li {
        margin-bottom: 0.5rem;
      }
      input,
      textarea,
      select,
      button {
        font: inherit;
      }
      .mono {
        font-family: var(--font-code);
      }
      /* Type scale: major third (1.25) from the 17px body. */
      h1 {
        font-size: 2.6rem;
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin: 0 0 1rem;
        font-weight: 800;
      }
      h2 {
        font-size: 1.66rem;
        line-height: 1.2;
        letter-spacing: -0.01em;
        margin: 0 0 1rem;
        font-weight: 700;
      }
      h3 {
        font-size: 1.33rem;
        line-height: 1.3;
        margin: 0 0 0.75rem;
        font-weight: 650;
      }
      h1, h2, h3 {
        color: var(--text);
        text-wrap: balance;
      }
      p {
        line-height: 1.6;
        margin: 0 0 1rem;
      }
      hr {
        border: 0;
        border-top: 1px solid var(--line);
        margin: 2rem 0;
      }
      /* Below 768px this is the only usable nav layout regardless of input
         type. Between 768–1024px, touch/coarse-pointer devices (tablets)
         also get it — the horizontal nav's tap-driven .nav-caret dropdowns
         don't leave enough room at those widths and wrap into a messy
         multi-row layout, so fall back to the stacked accordion nav. Wider
         coarse-pointer devices (e.g. touchscreen desktops) still get the
         horizontal nav with tap dropdowns. */
      @media (max-width: 768px), ((pointer: coarse) and (max-width: 1024px)) {
        main {
          padding: 1.5rem;
        }
        header {
          flex-wrap: wrap;
          justify-content: space-between;
          gap: 0.75rem;
        }
        .nav-toggle {
          display: flex;
        }
        #site-nav {
          display: none;
          width: 100%;
          flex-direction: column;
          align-items: stretch;
        }
        #site-nav.nav-open {
          display: flex;
        }
        #site-nav a {
          width: 100%;
          white-space: normal;
        }
        .nav-dropdown-wrapper,
        .nav-flyout-item {
          display: flex;
          align-items: stretch;
          flex-wrap: wrap;
        }
        #site-nav .nav-dropdown-wrapper > a,
        #site-nav .nav-flyout-item > a {
          width: auto;
          flex: 1 1 auto;
        }
        .nav-caret,
        .nav-flyout-item > .nav-caret {
          min-width: 2.75rem;
          padding: 0;
        }
        /* Submenus stack below here, so every chevron points down again. */
        .nav-flyout-item > .nav-caret::after {
          transform: translateY(-0.12rem) rotate(45deg);
        }
        .nav-flyout-item > .nav-caret[aria-expanded="true"]::after {
          transform: translateY(0.12rem) rotate(-135deg);
        }
        .nav-dropdown,
        .nav-flyout {
          position: static;
          display: none;
          flex-basis: 100%;
          width: 100%;
          box-shadow: none;
          background: transparent;
          border: none;
          padding-left: 0.75rem;
        }
        h1 {
          font-size: 2rem;
        }
        h2 {
          font-size: 1.4rem;
        }
      }

      /* ── Prose ────────────────────────────────── */
      .prose { line-height: 1.7; }
      .prose p { margin: 0 0 1rem; }

      /* Running text gets Source Sans 3 and a readable measure. Only direct
         children, so shortcode widgets keep the UI face and full width. */
      .prose > p,
      .prose > ul,
      .prose > ol,
      .prose > blockquote {
        font-family: var(--font-read);
        font-size: 1.125rem;
        line-height: 1.75;
        max-width: var(--measure);
      }
      .prose > h2,
      .prose > h3,
      .prose > h4 {
        max-width: var(--measure);
      }

      .prose h2 {
        font-size: 1.5rem;
        font-weight: 750;
        letter-spacing: -0.01em;
        color: var(--text);
        margin: 2.75rem 0 0.8rem;
        clear: both;
      }
      .prose h3 {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--text);
        margin: 2rem 0 0.5rem;
        clear: both;
      }
      .prose h4 {
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 1.25rem 0 0.4rem;
      }

      .prose table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 0.9rem;
        margin: 1.25rem 0;
        border: 1px solid var(--line);
        border-radius: var(--r-md,10px);
        overflow: hidden;
      }
      .prose thead {
        background:var(--surface-2);
      }
      .prose th {
        padding: 0.7rem 1rem;
        text-align: left;
        font-weight: 600;
        color: var(--accent);
        border-bottom: 2px solid var(--line);
        white-space: nowrap;
      }
      .prose td {
        padding: 0.6rem 1rem;
        border-bottom: 1px solid var(--line);
        vertical-align: top;
      }
      .prose tr:last-child td { border-bottom: 0; }
      .prose tbody tr:hover { background: rgb(from var(--accent) r g b / 4%); }

      .prose blockquote {
        margin: 1.25rem 0;
        padding: 1rem 1.25rem;
        background: rgb(from var(--accent) r g b / 6%);
        border-radius: var(--r-md,10px);
        border: 1px solid rgb(from var(--accent) r g b / 18%);
      }
      .prose blockquote p { margin: 0; line-height: 1.9; }

      .prose ul, .prose ol { margin: 0 0 1rem 1.35rem; padding: 0; }
      .prose li { margin-bottom: 0.35rem; }
      .prose li::marker { color: var(--accent); }

      .prose a { color: var(--accent); text-decoration: none; }
      .prose a:hover { text-decoration: underline; }
      /* In running text a link must not rely on color alone. */
      .prose > p a,
      .prose > ul a,
      .prose > ol a,
      .prose > blockquote a {
        text-decoration: underline;
        text-decoration-color: rgb(from var(--accent) r g b / 45%);
        text-decoration-thickness: 1px;
        text-underline-offset: 3px;
      }
      .prose > p a:hover,
      .prose > ul a:hover,
      .prose > ol a:hover,
      .prose > blockquote a:hover {
        text-decoration-color: currentColor;
      }

      .prose strong { color: var(--text); font-weight: 600; }
      .prose em { font-style: italic; }

      .prose code {
        background: var(--surface-2);
        border: 1px solid var(--line);
        border-radius: var(--r-sm,6px);
        padding: 0.1rem 0.4rem;
        font-size: 0.875em;
        font-family: var(--font-code);
      }
      .prose pre {
        background: var(--bg);
        border: 1px solid var(--line);
        border-radius: var(--r-md,10px);
        padding: 1.25rem 1.5rem;
        overflow-x: auto;
        margin: 1.25rem 0;
        font-size: 0.875rem;
        line-height: 1.65;
        font-family: var(--font-code);
      }
      .prose pre code {
        background: none;
        border: none;
        padding: 0;
        border-radius: 0;
        font-size: inherit;
      }

      .prose hr {
        border: 0;
        border-top: 1px solid var(--line);
        margin: 2rem 0;
      }

      /* ── Overview cards ── */
      .prose .overview-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
        gap: 0.75rem;
        margin: 1.25rem 0;
      }
      .prose .overview-card {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        padding: 0.85rem 1rem;
        background: var(--surface-2);
        border: 1px solid var(--line);
        border-top: 2px solid var(--accent);
        border-radius: var(--r-md,10px);
        transition: border-color 0.2s ease;
      }
      .prose .overview-card:hover {
        border-color: rgb(from var(--accent) r g b / 40%);
        border-top-color: var(--accent);
      }
      .prose .overview-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
      }
      .prose .overview-value {
        font-size: 0.975rem;
        font-weight: 600;
        color: var(--text);
      }

      .prose img {
        max-width: 100%;
        border-radius: var(--r-md,10px);
        border: 1px solid var(--line);
        margin: 1rem 0;
        display: block;
      }

      .prose img.float-left,
      .prose img.float-right {
        max-width: min(420px, 50%);
        margin-top: 0.25rem;
        margin-bottom: 1rem;
      }
      .prose img.float-left {
        float: left;
        margin-right: 1.5rem;
      }
      .prose img.float-right {
        float: right;
        margin-left: 1.5rem;
      }
      @media (max-width: 560px) {
        .prose img.float-left,
        .prose img.float-right {
          float: none;
          max-width: 100%;
          margin-left: 0;
          margin-right: 0;
        }
      }

      .prose::after {
        content: "";
        display: table;
        clear: both;
      }

      /* ── Accordion (details/summary) ── */
      .prose details {
        border: 1px solid var(--line);
        border-radius: var(--r-md,10px);
        margin: 0.75rem 0;
        background: var(--surface-2);
        overflow: hidden;
        transition: border-color 0.2s ease;
      }
      .prose details[open] {
        border-color: rgb(from var(--accent) r g b / 30%);
      }
      .prose summary {
        cursor: pointer;
        list-style: none;
        padding: 1rem 1.25rem;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 0.65rem;
        user-select: none;
        transition: background 0.15s ease, color 0.15s ease;
      }
      .prose summary::-webkit-details-marker { display: none; }
      .prose summary::before {
        content: "›";
        color: var(--accent);
        font-size: 1.25rem;
        line-height: 1;
        flex-shrink: 0;
        transition: transform var(--transition-fast);
        display: inline-block;
      }
      .prose details[open] > summary::before { transform: rotate(90deg); }
      .prose summary:hover { background: rgb(from var(--accent) r g b / 4%); color: var(--accent); }
      .prose details > *:not(summary) {
        padding-left: 1.25rem;
        padding-right: 1.25rem;
      }
      .prose details > *:not(summary):last-child { padding-bottom: 1.25rem; }

      /* ── Atlas node grid ── */
      .prose table[data-node-table] th {
        text-align: center;
        width: 80px;
      }
      .prose td[data-node="on"] {
        text-align: center;
        font-size: 1.15rem;
        color: var(--accent);
        background:var(--surface-2);

        text-shadow: 0 0 8px rgb(from var(--accent) r g b / 70%);
      }
      .prose td[data-node="off"] {
        text-align: center;
        font-size: 1.1rem;
        color: var(--muted);
        background: rgb(0 0 0 / 25%);
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="container">
      <header>
        <a href="/" class="header-logo">
          <img src="/images/logo-480.png" alt="Orboro.net" width="480" height="115" />
        </a>
        <button
          type="button"
          class="nav-toggle"
          id="nav-toggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <span class="nav-toggle-bar" /><span class="nav-toggle-bar" /><span class="nav-toggle-bar" />
        </button>
        <nav id="site-nav" aria-label="Main">
          <a href="/" class={isActive("/") ? "active" : ""}><Icon name="home" size={15} />Home</a>
          <a href="/blog" class={isActive("/blog") ? "active" : ""}><Icon name="file-text" size={15} />Blog</a>
          {navTree.map(node => {
            if (node.children.length > 0) {
              const dropdownId = `nav-dropdown-${node.id}`;
              return (
                <div class="nav-dropdown-wrapper">
                  <a href={node.url} class={isActive(node.url) ? "active" : ""}><Icon name={nodeIcon(node)} size={15} />{node.label}</a>
                  <button type="button" class="nav-caret" aria-label={`Toggle ${node.label} submenu`} aria-expanded="false" aria-controls={dropdownId} />
                  <div class="nav-dropdown" id={dropdownId} set:html={renderDropdownItems(node.children)} />
                </div>
              );
            }
            return <a href={node.url} class={isActive(node.url) ? "active" : ""}><Icon name={nodeIcon(node)} size={15} />{node.label}</a>;
          })}
          <a href="https://www.patreon.com/cw/Orboro" target="_blank" rel="noopener noreferrer"><Icon name="patreon" size={15} filled />Support Me</a>
        </nav>
      </header>
      <main id="main-content" tabindex="-1" class:list={[hasHeaderFeature && "main-with-feature"]}>
        <slot name="headerFeature" />
        {hasHeaderFeature ? <div class="main-panel"><slot /></div> : <slot />}
      </main>
      <Footer />
      {analytics && <ConsentBanner />}
    </div>
    <script is:inline nonce={nonce}>
      function styleNodeTables() {
        document.querySelectorAll('.prose table').forEach(function(table) {
          var isNodeTable = false;
          table.querySelectorAll('td').forEach(function(td) {
            var text = td.textContent.trim();
            if (text === '✓') { td.setAttribute('data-node', 'on'); td.setAttribute('aria-label', 'obtained'); isNodeTable = true; }
            else if (text === '✗') { td.setAttribute('data-node', 'off'); td.setAttribute('aria-label', 'not obtained'); isNodeTable = true; }
          });
          if (isNodeTable) table.setAttribute('data-node-table', '');
        });
      }

      // Native details/summary preserves keyboard toggling and reflow without height caps.

      function setSubmenuOpen(item, open) {
        item.classList.toggle('open', open);
        var caret = item.querySelector(':scope > .nav-caret');
        if (caret) caret.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (!open) {
          item.querySelectorAll('.nav-dropdown-wrapper.open, .nav-flyout-item.open').forEach(function(child) {
            child.classList.remove('open');
            var childCaret = child.querySelector(':scope > .nav-caret');
            if (childCaret) childCaret.setAttribute('aria-expanded', 'false');
          });
        }
      }

      function initMobileNav() {
        var toggle = document.getElementById('nav-toggle');
        var nav = document.getElementById('site-nav');
        if (toggle && nav && !toggle.dataset.navInit) {
          toggle.dataset.navInit = '1';
          toggle.addEventListener('click', function() {
            var isOpen = nav.classList.toggle('nav-open');
            toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            if (!isOpen) closeMobileNav();
          });
          nav.addEventListener('focusin', function(e) {
            var target = e.target;
            if (!(target instanceof Element)) return;
            var item = target.closest('.nav-dropdown-wrapper, .nav-flyout-item');
            // Focusing a toggle should not pre-open it before Enter or click.
            if (target.classList.contains('nav-caret')) {
              item = item && item.parentElement.closest('.nav-dropdown-wrapper, .nav-flyout-item');
            }
            while (item && nav.contains(item)) {
              setSubmenuOpen(item, true);
              item = item.parentElement.closest('.nav-dropdown-wrapper, .nav-flyout-item');
            }
          });
          nav.addEventListener('focusout', function(e) {
            var next = e.relatedTarget;
            nav.querySelectorAll('.nav-dropdown-wrapper.open, .nav-flyout-item.open').forEach(function(item) {
              if ((!next || !item.contains(next)) && !item.matches(':hover')) setSubmenuOpen(item, false);
            });
          });
          nav.addEventListener('keydown', function(e) {
            var target = e.target;
            if (!(target instanceof Element) || !target.matches('a, .nav-caret')) return;
            var item = target.closest('.nav-dropdown-wrapper, .nav-flyout-item');
            if (e.key === 'Escape') {
              if (!item) return;
              e.preventDefault();
              var caret = item.querySelector(':scope > .nav-caret');
              if (caret) caret.focus();
              setSubmenuOpen(item, false);
              return;
            }
            if (e.key === 'ArrowRight' && item && item.classList.contains('nav-flyout-item') && target.parentElement === item) {
              e.preventDefault();
              setSubmenuOpen(item, true);
              var firstChild = item.querySelector(':scope > .nav-flyout > a, :scope > .nav-flyout > .nav-flyout-item > a');
              if (firstChild) firstChild.focus();
              return;
            }
            if (e.key === 'ArrowLeft') {
              var panel = target.closest('.nav-flyout');
              if (!panel) return;
              e.preventDefault();
              var owner = panel.parentElement;
              var parentLink = owner.querySelector(':scope > a');
              if (parentLink) parentLink.focus();
              setSubmenuOpen(owner, false);
              return;
            }
            if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
            var panel = target.closest('.nav-dropdown, .nav-flyout');
            if (!panel && item) {
              e.preventDefault();
              setSubmenuOpen(item, true);
              panel = item.querySelector(':scope > .nav-dropdown, :scope > .nav-flyout');
              var first = panel && panel.querySelector(':scope > a, :scope > .nav-flyout-item > a');
              if (first) first.focus();
              return;
            }
            if (!panel) return;
            var links = Array.from(panel.children).map(function(child) {
              return child.matches('a') ? child : child.querySelector(':scope > a');
            }).filter(Boolean);
            var current = target.classList.contains('nav-caret') ? target.parentElement.querySelector(':scope > a') : target;
            var index = links.indexOf(current);
            if (index < 0) return;
            e.preventDefault();
            links[(index + (e.key === 'ArrowDown' ? 1 : links.length - 1)) % links.length].focus();
          });
          nav.querySelectorAll('.nav-dropdown-wrapper, .nav-flyout-item').forEach(function(item) {
            item.addEventListener('pointerenter', function() {
              if (matchMedia('(hover: hover) and (pointer: fine) and (min-width: 769px)').matches) setSubmenuOpen(item, true);
            });
            item.addEventListener('pointerleave', function() {
              if (!item.contains(document.activeElement)) setSubmenuOpen(item, false);
            });
          });
        }
        document.querySelectorAll('.nav-caret').forEach(function(btn) {
          if (btn.dataset.navInit) return;
          btn.dataset.navInit = '1';
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var parent = btn.closest('.nav-dropdown-wrapper, .nav-flyout-item');
            if (!parent) return;
            setSubmenuOpen(parent, !parent.classList.contains('open'));
          });
        });
      }

      function closeMobileNav() {
        var toggle = document.getElementById('nav-toggle');
        var nav = document.getElementById('site-nav');
        if (nav) nav.classList.remove('nav-open');
        if (toggle) toggle.setAttribute('aria-expanded', 'false');
        document.querySelectorAll('.nav-dropdown-wrapper.open, .nav-flyout-item.open').forEach(function(item) {
          setSubmenuOpen(item, false);
        });
      }

      styleNodeTables();

      initMobileNav();
      document.addEventListener('astro:page-load', function() {
        styleNodeTables();

        closeMobileNav();
        initMobileNav();
      });
    </script>
  </body>
</html>
