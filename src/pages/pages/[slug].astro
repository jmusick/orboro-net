---
import { renderMarkdown } from "../../lib/markdown";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SidebarLayout from "../../components/SidebarLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getPublishedBySlugAndType, listPostSummaries, listCategoriesWithPostCounts, listNavItems } from "../../lib/content";
import { breadcrumbList, classifyPage, graphOf, pageNode, pageTrail, withHome } from "../../lib/structured-data";
import { processShortcodes } from "../../lib/shortcodes";
import { formatPageUpdatedAt } from "../../lib/dates";

const { slug } = Astro.params;
if (!slug) return Astro.rewrite("/404");

const page = await getPublishedBySlugAndType(Astro.locals, slug, "page");
if (!page) return Astro.rewrite("/404");

const html = await processShortcodes(renderMarkdown(page.markdown), Astro.locals.nonce);
const updated = formatPageUpdatedAt(page.updatedAt);

function descriptionFromMarkdown(md: string, maxLen = 155): string {
  const plain = md
    .replace(/```[\s\S]*?```/g, '')
    // Shortcode tokens are widget placeholders, not prose. Without this a
    // shortcode-only page ends up with "{{atlasfarmingstrategies}}" as its
    // meta description (the underscores get eaten by the emphasis strip).
    .replace(/\{\{\w+[^}]*\}\}/g, '')
    // Markdown may contain raw HTML (the About page opens with an <img>), and
    // an unstripped tag ends up escaped into the meta description verbatim.
    .replace(/<[^>]+>/g, ' ')
    .replace(/#{1,6}\s+[^\n]*/g, '')
    .replace(/!\[.*?\]\(.*?\)/g, '')
    .replace(/\[(.+?)\]\(.*?\)/g, '$1')
    .replace(/[*_`~]+/g, '')
    .replace(/^\s*[-*+>|]\s*/gm, '')
    .replace(/\n+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
  return plain.length > maxLen ? plain.slice(0, maxLen).trimEnd() + '…' : plain;
}

const description = descriptionFromMarkdown(page.markdown) || `${page.title} on Orboro.net.`;

// Shortcode widgets (cheat sheets, explorers) need the whole panel. A page
// that is only prose would leave most of the panel empty beside its capped
// text column, so it gets the blog sidebar instead, like a post.
const hasWidgets = /\{\{\w+/.test(page.markdown);
const [categories, recentPosts] = hasWidgets
  ? [[], []]
  : await Promise.all([
      listCategoriesWithPostCounts(Astro.locals),
      listPostSummaries(Astro.locals, 5).then((posts) =>
        posts.map((p) => ({
          slug: p.slug,
          title: p.title,
          dateLabel: new Date(p.publishedAt ?? p.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }),
        })),
      ),
    ]);

const BASE = (Astro.site ?? new URL("https://orboro.net")).origin;
const absoluteImageUrl = page.featuredImageUrl ? new URL(page.featuredImageUrl, BASE).href : undefined;

const pagePath = `/pages/${page.slug}`;
const trail = withHome(pageTrail(await listNavItems(Astro.locals), page.id, page.title, pagePath));
const structuredData = graphOf(
  pageNode({
    type: classifyPage(page.markdown),
    origin: BASE,
    path: pagePath,
    title: page.title,
    description,
    imageUrl: absoluteImageUrl,
    publishedAt: page.publishedAt ?? page.createdAt,
    updatedAt: page.updatedAt,
  }),
  breadcrumbList(trail, BASE),
);
---

<BaseLayout title={`${page.title} | Orboro.net`} description={description} ogType="article" ogImage={absoluteImageUrl} structuredData={structuredData}>
  <SidebarLayout sidebar={!hasWidgets}>
    <article class="page-content">
      <Breadcrumbs trail={trail} />
      <h1>{page.title}</h1>
      {updated && <p class="meta">Updated {updated}</p>}
      {page.featuredImageUrl && (
        <img class="hero" src={page.featuredImageUrl} alt="" />
      )}
      <div class="prose" set:html={html} />
    </article>
    <Sidebar slot="sidebar" categories={categories} recentPosts={recentPosts} />
  </SidebarLayout>
</BaseLayout>

<style>
  /* A leading Markdown header image fills the panel rather than the text measure. */
  .page-content :global(.prose > p:first-child:has(> img:only-child:not(.float-left):not(.float-right))) {
    max-width: none;
  }

  /* Same columns as a blog post, so text pages and posts line up. */

  .meta {
    color: var(--muted);
    font-size: 0.9rem;
    margin: -0.5rem 0 1.5rem;
  }

  .hero {
    display: block;
    width: 100%;
    max-height: 360px;
    object-fit: cover;
    border-radius: var(--r-md,10px);
    margin-bottom: 1.5rem;
  }
</style>
