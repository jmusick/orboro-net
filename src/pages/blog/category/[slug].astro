---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import Sidebar from "../../../components/Sidebar.astro";
import SidebarLayout from "../../../components/SidebarLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { breadcrumbList, graphOf } from "../../../lib/structured-data";
import { getCategoryBySlug, getPublishedContentByCategory, excerptFromMarkdown, listCategoriesWithPostCounts, listPostSummaries } from "../../../lib/content";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/blog");

const category = await getCategoryBySlug(Astro.locals, slug);
if (!category) return Astro.redirect("/blog");

const posts = await getPublishedContentByCategory(Astro.locals, slug, "post");
const [categories, summaries] = await Promise.all([
  listCategoriesWithPostCounts(Astro.locals),
  listPostSummaries(Astro.locals, 5),
]);
const recentPosts = summaries.map((post) => ({
  slug: post.slug,
  title: post.title,
  dateLabel: new Date(post.publishedAt ?? post.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }),
}));

const BASE = (Astro.site ?? new URL("https://orboro.net")).origin;
const categoryPath = `/blog/category/${category.slug}`;
const trail = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog" },
  { name: category.name, path: categoryPath },
];
const categoryDescription = `Browse posts in the ${category.name} category on Orboro.net.`;
const structuredData = graphOf(
  {
    "@type": "CollectionPage",
    "@id": `${BASE}${categoryPath}`,
    url: `${BASE}${categoryPath}`,
    name: category.name,
    description: categoryDescription,
    isPartOf: { "@id": `${BASE}/#website` },
  },
  breadcrumbList(trail, BASE),
);
---

<BaseLayout title={`${category.name} | Orboro.net`} description={categoryDescription} structuredData={structuredData}>
  <SidebarLayout>
  <section>
    <Breadcrumbs trail={trail} />
    <h1>{category.name}</h1>
    {posts.length === 0 ? (
      <p class="empty">No published posts in this category yet.</p>
    ) : (
      <div class="posts-grid">
        {posts.map((post) => (
          <PostCard title={post.title} slug={post.slug} image={post.featuredImageUrl}
            dateIso={new Date(post.publishedAt ?? post.createdAt).toISOString()}
            dateLabel={new Date(post.publishedAt ?? post.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
            excerpt={excerptFromMarkdown(post.markdown, 140)} />
        ))}
      </div>
    )}
  </section>
  <Sidebar slot="sidebar" categories={categories} recentPosts={recentPosts} activeCategorySlug={slug} />
  </SidebarLayout>
</BaseLayout>

<style>
  h1 { margin-bottom: 1.5rem; }

  .empty { color: var(--muted); font-style: italic; }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 768px) {
    .posts-grid { grid-template-columns: 1fr; }
  }
</style>
