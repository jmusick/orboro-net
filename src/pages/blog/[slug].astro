---
import { renderMarkdown } from "../../lib/markdown";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import PageHeader from "../../components/PageHeader.astro";
import TopicChip from "../../components/TopicChip.astro";
import Icon from "../../components/Icon.astro";
import Comments from "../../components/Comments.astro";
import StoryCard from "../../components/StoryCard.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import {
  getPublishedBySlugAndType,
  listPostSummaries,
  getContentCategories,
  excerptFromMarkdown,
  listCategoriesWithPostCounts,
  listHomepageFeatures,
  listRelatedPosts,
} from "../../lib/content";
import { processShortcodes } from "../../lib/shortcodes";
import { breadcrumbList, graphOf } from "../../lib/structured-data";
import { addHeadingIds } from "../../lib/toc";
import { PATREON_URL } from "../../lib/profiles";
import { gameHubsForCategories } from "../../lib/topics";

function estimateReadingMinutes(markdown: string): number {
  const words = markdown
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/[#*_~`>|]/g, " ")
    .split(/\s+/)
    .filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.rewrite("/404");
}

const post = await getPublishedBySlugAndType(Astro.locals, slug, "post");
if (!post) {
  return Astro.rewrite("/404");
}

// The "Keep reading" row stands in for the sidebar's recent posts, so the page
// doesn't list the same posts twice.
const [categories, postCategories, allPosts, relatedPosts, featuredPages] = await Promise.all([
  listCategoriesWithPostCounts(Astro.locals),
  getContentCategories(Astro.locals, post.id),
  listPostSummaries(Astro.locals, 500),
  listRelatedPosts(Astro.locals, post.id),
  listHomepageFeatures(Astro.locals),
]);

// A post tagged with both games shows both tool groups, WoW first.
const toolGroups = gameHubsForCategories(postCategories.map((cat) => cat.slug)).map((hub) => ({
  hub,
  tools: featuredPages.filter((page) => page.homepageGroup === hub.group),
}));

const currentIndex = allPosts.findIndex((p) => p.slug === post.slug);
const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const olderPost = currentIndex >= 0 && currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const adjacent = [
  olderPost && { post: olderPost, label: "Older", rel: "prev" },
  newerPost && { post: newerPost, label: "Newer", rel: "next" },
].filter((item) => !!item);

// Heading ids are added before shortcodes expand, so only author headings are listed.
const { html: articleHtml, headings } = addHeadingIds(renderMarkdown(post.markdown));
const html = await processShortcodes(articleHtml, Astro.locals.nonce);
const showToc = headings.length >= 3;

const updated = new Date(post.updatedAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const description = excerptFromMarkdown(post.markdown);

const readingMinutes = estimateReadingMinutes(post.markdown);

const BASE = (Astro.site ?? new URL("https://orboro.net")).origin;
const canonicalUrl = `${BASE}/blog/${post.slug}`;
const absoluteImageUrl = post.featuredImageUrl ? new URL(post.featuredImageUrl, BASE).href : undefined;

const publishedIso = new Date(post.publishedAt ?? post.createdAt).toISOString();
const updatedIso = new Date(post.updatedAt).toISOString();

// Categories are tags, not a hierarchy: use the first (alphabetical) one so the
// trail is stable. Posts with no category get Home > Blog > Post.
const primaryCategory = postCategories[0];
const trail = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog" },
  ...(primaryCategory ? [{ name: primaryCategory.name, path: `/blog/category/${primaryCategory.slug}` }] : []),
  { name: post.title, path: `/blog/${post.slug}` },
];

const blogPosting = {
  "@type": "BlogPosting",
  headline: post.title,
  description,
  datePublished: publishedIso,
  dateModified: updatedIso,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  ...(absoluteImageUrl ? { image: [absoluteImageUrl] } : {}),
  author: { "@type": "Person", name: "JD" },
  publisher: {
    "@type": "Organization",
    name: "Orboro.net",
    logo: { "@type": "ImageObject", url: `${BASE}/images/logo.png` },
  },
};
const structuredData = graphOf(blogPosting, breadcrumbList(trail, BASE));
---

<BaseLayout
  title={`${post.title} | Orboro.net`}
  description={description}
  ogType="article"
  ogImage={absoluteImageUrl}
  ogImageAlt={absoluteImageUrl ? `Featured image for ${post.title}` : undefined}
  structuredData={structuredData}
>
  <PageHeader slot="hero" title={post.title} trail={trail} image={post.featuredImageUrl} variant="article">
    <span>By JD</span>
    <span>Updated <time datetime={updatedIso}>{updated}</time></span>
    <span>{readingMinutes} min read</span>
    {postCategories.length > 0 && (
      <span class="chips">
        {postCategories.map((cat) => <TopicChip name={cat.name} slug={cat.slug} />)}
      </span>
    )}
  </PageHeader>

  <div class="post-layout">
    <article class="post-body">
      {showToc && (
        <details class="toc-inline">
          <summary>On this page</summary>
          <ol>
            {headings.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}
          </ol>
        </details>
      )}
      <div class="prose" set:html={html} />

      <aside class="author" aria-label="About the author">
        <img src="/favicon-192.png" alt="" width="48" height="48" loading="lazy" />
        <div class="author__text">
          <strong>Written by JD</strong>
          <span>Guides, analysis and tools for World of Warcraft and Path of Exile 2. Reader-supported.</span>
        </div>
        <a class="author__support" href={PATREON_URL} target="_blank" rel="noopener noreferrer"><Icon name="patreon" size={14} filled />Support on Patreon</a>
      </aside>

      {post.commentsMode !== "hidden" && <Comments contentId={post.id} path={`/blog/${post.slug}`} mode={post.commentsMode} />}
    </article>

    <div class="post-aside">
      {showToc && (
        <nav class="toc" aria-labelledby="toc-title">
          <h2 id="toc-title">On this page</h2>
          <ol>
            {headings.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )}
      <Sidebar categories={categories} recentPosts={[]} />
    </div>
  </div>

  {(relatedPosts.length > 0 || toolGroups.length > 0) && (
    <div class="keep-reading">
      {relatedPosts.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <h2 id="related-title">Keep reading</h2>
          <div class="related__grid">
            {relatedPosts.map((other) => (
              <StoryCard slug={other.slug} title={other.title} image={other.featuredImageUrl}
                dateIso={new Date(other.date).toISOString()}
                dateLabel={new Date(other.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
                excerpt={other.excerpt} category={other.category} headingLevel="h3" />
            ))}
          </div>
        </section>
      )}
      <RelatedTools groups={toolGroups} />
    </div>
  )}

  {adjacent.length > 0 && (
    <nav class="post-nav" aria-label="More posts">
      {adjacent.map(({ post: other, label, rel }) => (
        <a class="post-nav__link" href={`/blog/${other.slug}`} rel={rel}>
          <span class="post-nav__art">
            {other.featuredImageUrl ? <img src={other.featuredImageUrl} alt="" loading="lazy" /> : <span class="post-nav__plain" />}
          </span>
          <span class="post-nav__text">
            <span class="post-nav__label">{label}</span>
            <span class="post-nav__title">{other.title}</span>
          </span>
        </a>
      ))}
    </nav>
  )}
</BaseLayout>

<style>
  /* Reading column at the measure, with contents and navigation beside it. */
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 46rem) minmax(0, 17rem);
    justify-content: space-between;
    gap: var(--space-16);
    max-width: 74rem;
    margin: 0 auto;
    align-items: start;
  }

  .post-body {
    min-width: 0;
  }

  .post-aside {
    position: sticky;
    top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .chips {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .toc h2 {
    margin: 0 0 var(--space-3);
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 700;
  }

  .toc ol,
  .toc-inline ol {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc li,
  .toc-inline li {
    margin: 0;
  }

  .toc a,
  .toc-inline a {
    display: block;
    padding: 0.45rem 0.75rem;
    border-radius: var(--r-md,10px);
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.4;
    text-decoration: none;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .toc a:hover,
  .toc-inline a:hover {
    background: var(--surface);
    color: #fff;
  }

  .toc-inline {
    display: none;
    margin: 0 0 var(--space-8);
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md,10px);
    background: var(--surface);
  }

  .toc-inline summary {
    padding: 0.6rem 0.25rem;
    font-weight: 700;
    cursor: pointer;
  }

  .toc-inline[open] ol {
    padding-bottom: 0.5rem;
  }

  .author {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-16);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--r-lg,16px);
    background: var(--surface);
  }

  .author img {
    width: 48px;
    height: 48px;
  }

  .author__text {
    flex: 1 1 16rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    color: var(--muted);
  }

  .author__text strong {
    color: var(--text);
  }

  .author__support {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 1.25rem;
    border-radius: var(--r-pill,999px);
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 700;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }

  .author__support:hover {
    background: var(--accent-hover);
  }

  .keep-reading {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    max-width: 74rem;
    margin: var(--space-16) auto 0;
    padding-top: var(--space-10);
    border-top: 1px solid var(--line);
  }

  .related h2 {
    margin: 0 0 var(--space-6);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
  }

  /* Explicit columns: one on phones, then always three, so three cards never
     split 2 + 1 and fewer than three keep a card's width instead of stretching. */
  .related__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem 1.5rem;
  }

  @media (min-width: 768px) {
    .related__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Three columns in the 46rem column leave cards ~14rem wide; Unbounded is wide,
     so a step down keeps long titles to four lines. StoryCard's default stays. */
  @media (min-width: 768px) and (max-width: 1080px) {
    .related__grid {
      column-gap: 1.25rem;
    }

    .related__grid :global(.story__title) {
      font-size: 0.95rem;
    }
  }

  /* One rule above the whole end-of-post block, not one per section. */
  .keep-reading + .post-nav {
    padding-top: 0;
    border-top: 0;
  }

  .post-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.25rem;
    max-width: 74rem;
    margin: var(--space-16) auto 0;
    padding-top: var(--space-10);
    border-top: 1px solid var(--line);
  }

  .post-nav__link {
    display: flex;
    min-height: 7.5rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-lg,16px);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color var(--transition-fast);
  }

  .post-nav__link:hover {
    border-color: var(--line-strong);
  }

  .post-nav__art {
    flex: 0 0 36%;
    overflow: hidden;
  }

  .post-nav__art img,
  .post-nav__plain {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .post-nav__plain {
    background: radial-gradient(circle at 75% 20%, rgb(from var(--accent) r g b / 18%), transparent 60%), var(--surface-2);
  }

  .post-nav__link:hover .post-nav__art img {
    transform: scale(1.04);
  }

  .post-nav__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    min-width: 0;
  }

  .post-nav__label {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .post-nav__title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }

  @media (max-width: 1080px) {
    .post-layout {
      grid-template-columns: minmax(0, 1fr);
      max-width: 46rem;
    }

    .post-aside {
      position: static;
    }

    .post-aside .toc {
      display: none;
    }

    .toc-inline {
      display: block;
    }

    .keep-reading,
    .post-nav {
      max-width: 46rem;
    }
  }
</style>
