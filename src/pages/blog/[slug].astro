---
import { renderMarkdown } from "../../lib/markdown";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SidebarLayout from "../../components/SidebarLayout.astro";
import Sidebar from "../../components/Sidebar.astro";
import {
  getPublishedBySlugAndType,
  listPostSummaries,
  getContentCategories,
  excerptFromMarkdown,
  listCategoriesWithPostCounts,
} from "../../lib/content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { processShortcodes } from "../../lib/shortcodes";
import { breadcrumbList, graphOf } from "../../lib/structured-data";

function estimateReadingMinutes(markdown: string): number {
  const words = markdown
    .replace(/```[\s\S]*?```/g, " ")
    .replace(/[#*_~`>|]/g, " ")
    .split(/\s+/)
    .filter(Boolean).length;
  return Math.max(1, Math.round(words / 200));
}

const { slug } = Astro.params;
if (!slug) {
  return Astro.rewrite("/404");
}

const post = await getPublishedBySlugAndType(Astro.locals, slug, "post");
if (!post) {
  return Astro.rewrite("/404");
}

const [categories, postCategories, allPosts] = await Promise.all([
  listCategoriesWithPostCounts(Astro.locals),
  getContentCategories(Astro.locals, post.id),
  listPostSummaries(Astro.locals, 500),
]);

const recentPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .slice(0, 5)
  .map((p) => ({
    slug: p.slug,
    title: p.title,
    dateLabel: new Date(p.publishedAt ?? p.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }),
  }));

const currentIndex = allPosts.findIndex((p) => p.slug === post.slug);
const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const olderPost = currentIndex >= 0 && currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;

const html = await processShortcodes(renderMarkdown(post.markdown), Astro.locals.nonce);

const updated = new Date(post.updatedAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const description = excerptFromMarkdown(post.markdown);

const readingMinutes = estimateReadingMinutes(post.markdown);

const BASE = (Astro.site ?? new URL("https://orboro.net")).origin;
const canonicalUrl = `${BASE}/blog/${post.slug}`;
const absoluteImageUrl = post.featuredImageUrl ? new URL(post.featuredImageUrl, BASE).href : undefined;

const publishedIso = new Date(post.publishedAt ?? post.createdAt).toISOString();
const updatedIso = new Date(post.updatedAt).toISOString();

// Categories are tags, not a hierarchy: use the first (alphabetical) one so the
// trail is stable. Posts with no category get Home > Blog > Post.
const primaryCategory = postCategories[0];
const trail = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog" },
  ...(primaryCategory ? [{ name: primaryCategory.name, path: `/blog/category/${primaryCategory.slug}` }] : []),
  { name: post.title, path: `/blog/${post.slug}` },
];

const blogPosting = {
  "@type": "BlogPosting",
  headline: post.title,
  description,
  datePublished: publishedIso,
  dateModified: updatedIso,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  ...(absoluteImageUrl ? { image: [absoluteImageUrl] } : {}),
  author: { "@type": "Person", name: "JD" },
  publisher: {
    "@type": "Organization",
    name: "Orboro.net",
    logo: { "@type": "ImageObject", url: `${BASE}/images/logo.png` },
  },
};
const structuredData = graphOf(blogPosting, breadcrumbList(trail, BASE));
---

<BaseLayout
  title={`${post.title} | Orboro.net`}
  description={description}
  ogType="article"
  ogImage={absoluteImageUrl}
  structuredData={structuredData}
>
  <SidebarLayout>
    <article>
      <Breadcrumbs trail={trail} />
      <h1>{post.title}</h1>
      <p class="meta">
        <span>By JD</span>
        <span>Updated <time datetime={updatedIso}>{updated}</time></span>
        <span>{readingMinutes} min read</span>
      </p>
      {post.featuredImageUrl && (
        <img class="hero" src={post.featuredImageUrl} alt="" />
      )}
      <div class="prose" set:html={html} />

      {postCategories.length > 0 && (
        <div class="tags">
          {postCategories.map((cat) => (
            <a class="tag" href={`/blog/category/${cat.slug}`}>{cat.name}</a>
          ))}
        </div>
      )}

      {(olderPost || newerPost) && (
        <nav class="post-nav" aria-label="More posts">
          {olderPost ? (
            <a class="post-nav__link post-nav__link--older" href={`/blog/${olderPost.slug}`}>
              <span class="post-nav__label">← Older</span>
              <span class="post-nav__title">{olderPost.title}</span>
            </a>
          ) : <span />}
          {newerPost ? (
            <a class="post-nav__link post-nav__link--newer" href={`/blog/${newerPost.slug}`}>
              <span class="post-nav__label">Newer →</span>
              <span class="post-nav__title">{newerPost.title}</span>
            </a>
          ) : <span />}
        </nav>
      )}
    </article>
    <Sidebar slot="sidebar" categories={categories} recentPosts={recentPosts} />
  </SidebarLayout>
</BaseLayout>

<style>

  article > h1 {
    max-width: 22ch;
    font-size: clamp(2rem, 1.3rem + 2vw, 3rem);
    letter-spacing: -0.025em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0 0 1.75rem;
  }

  .hero {
    display: block;
    width: 100%;
    max-height: 380px;
    object-fit: cover;
    border-radius: var(--r-md,10px);
    margin-bottom: 2.25rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .tag {
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: var(--r-pill,999px);
    background: rgb(from var(--accent) r g b / 8%);
    color: var(--accent);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 500;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .tag:hover {
    border-color: var(--accent);
    background: rgb(from var(--accent) r g b / 15%);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .post-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md,10px);
    background: var(--surface-2);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.2s ease;
    min-width: 0;
  }

  .post-nav__link:hover {
    border-color: var(--accent);
  }

  .post-nav__link--newer {
    text-align: right;
    align-items: flex-end;
  }

  .post-nav__label {
    font-size: 0.78rem;
    color: var(--muted);
  }

  .post-nav__title {
    font-size: 0.9rem;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  @media (max-width: 600px) {
    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav__link--newer {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
