---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import FormMessage from "../../../components/FormMessage.astro";
import Button from "../../../components/Button.astro";
import { requireAdmin } from "../../../lib/http";
import { listNavItems, listAdminContent } from "../../../lib/content";
import { jsonForHtml } from "../../../lib/json";

const access = requireAdmin(Astro);
if (access instanceof Response) return access;

const navItems = await listNavItems(Astro.locals);
const allContent = await listAdminContent(Astro.locals);
const publishedContent = allContent.filter((c) => c.status === "published");

const url = new URL(Astro.request.url);
const saved = url.searchParams.get("saved") === "1";
const error = url.searchParams.get("error");

const initNav = navItems
  .map((item) => ({
    clientId: item.id,
    contentId: item.contentId ?? undefined,
    label: item.label,
    parentId: item.parentItemId ?? null,
    sortOrder: item.sortOrder,
  }));
const initContent = publishedContent.map((c) => ({
  id: c.id,
  title: c.title,
  slug: c.slug,
  pageType: c.pageType,
}));
---

<AdminLayout title="Navigation">
  {saved && <FormMessage>Navigation saved successfully.</FormMessage>}
  {error === "invalid" && <FormMessage error fields={[{ id: "nav-list", label: "Review navigation items" }]}>Navigation was not saved. Review the items and try again.</FormMessage>}

  <script is:inline type="application/json" id="nav-init" set:html={jsonForHtml({ nav: initNav, content: initContent })} />

  <section class="nav-section">
    <form id="nav-form" method="post" action="/api/nav/save">
      <input type="hidden" name="navItems" id="nav-items-json" />

      <div class="nav-panel">
        <h2 class="panel-title">Current Navigation</h2>
        <p class="panel-desc">Top-level items appear in the nav bar. Sub-items appear as a dropdown. Use ↑↓ to reorder within each level.</p>
        <ul id="nav-list" tabindex="-1" class="nav-list"></ul>
      </div>

      <div class="nav-panel add-panel">
        <h2 class="panel-title">Add Item</h2>
        <div class="add-row">
          <div class="nav-field add-field">
            <label for="content-select">Page or post</label>
            <select id="content-select" class="field-select">
              <option value="">— select page —</option>
            </select>
          </div>
          <div class="nav-field add-field">
            <label for="parent-select">Parent item</label>
            <select id="parent-select" class="field-select">
              <option value="">Top Level</option>
            </select>
          </div>
          <button type="button" id="add-btn" class="btn-add">Add to Nav</button>
        </div>
      </div>

      <div class="form-actions">
        <Button type="submit" variant="primary" icon="check">Save Navigation</Button>
      </div>
    </form>
  </section>

  <script is:inline nonce={Astro.locals.nonce}>
    (function () {
      var initEl = document.getElementById('nav-init');
      if (!initEl) return;
      var data = JSON.parse(initEl.textContent || '{}');
      var navItems = (data.nav || []).slice();
      var allContent = data.content || [];
      var idCounter = Date.now();

      function newId() { return 'c' + (++idCounter); }

      navItems.forEach(function (item) {
        if (!item.clientId) item.clientId = newId();
      });

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;')
          .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
      }

      function getItemUrl(item) {
        var c = allContent.find(function (c) { return c.id === item.contentId; });
        if (!c) return '#';
        return c.pageType === 'post' ? '/blog/' + c.slug : '/pages/' + c.slug;
      }

      function getItemBadge(item) {
        var c = allContent.find(function (c) { return c.id === item.contentId; });
        return c ? c.pageType : 'page';
      }

      function siblingsOf(parentId) {
        var p = parentId || null;
        return navItems.filter(function (i) { return (i.parentId || null) === p; });
      }

      // Is checkId equal to ancestorId or a descendant of it?
      function isInSubtree(ancestorId, checkId) {
        if (checkId === ancestorId) return true;
        var item = navItems.find(function (i) { return i.clientId === checkId; });
        if (!item || !item.parentId) return false;
        return isInSubtree(ancestorId, item.parentId);
      }

      function moveSibling(clientId, dir) {
        var item = navItems.find(function (i) { return i.clientId === clientId; });
        if (!item) return;
        var siblings = siblingsOf(item.parentId).sort(function (a, b) { return a.sortOrder - b.sortOrder; });
        var idx = siblings.findIndex(function (i) { return i.clientId === clientId; });
        var swapIdx = idx + dir;
        if (swapIdx < 0 || swapIdx >= siblings.length) return;
        var a = navItems.find(function (i) { return i.clientId === siblings[idx].clientId; });
        var b = navItems.find(function (i) { return i.clientId === siblings[swapIdx].clientId; });
        var tmp = a.sortOrder; a.sortOrder = b.sortOrder; b.sortOrder = tmp;
        render({ id: clientId, control: dir < 0 ? 'up' : 'down' });
      }

      function removeItem(clientId) {
        var item = navItems.find(function (i) { return i.clientId === clientId; });
        if (!item) return;
        var toRemove = {};
        function collect(id) {
          toRemove[id] = true;
          navItems.filter(function (i) { return i.parentId === id; }).forEach(function (c) { collect(c.clientId); });
        }
        collect(clientId);
        var siblings = siblingsOf(item.parentId)
          .sort(function (a, b) { return a.sortOrder - b.sortOrder; });
        var idx = siblings.findIndex(function (i) { return i.clientId === clientId; });
        var neighbour = siblings[idx + 1] || siblings[idx - 1];
        var removed = siblings[idx];
        navItems = navItems.filter(function (i) { return !toRemove[i.clientId]; });
        render({ id: neighbour ? neighbour.clientId : removed.parentId, control: neighbour ? 'remove' : 'label' });
      }

      function updateLabel(clientId, val) {
        var item = navItems.find(function (i) { return i.clientId === clientId; });
        if (item) {
          item.label = val;
          // Update names without replacing the input or disturbing its caret.
          document.querySelectorAll('#nav-list [data-id]').forEach(function (control) {
            if (control.getAttribute('data-id') !== clientId) return;
            control.setAttribute('aria-label', controlName(control.getAttribute('data-focus'), item));
          });
        }
      }

      function changeParent(clientId, newParentId) {
        var item = navItems.find(function (i) { return i.clientId === clientId; });
        if (!item) return;
        // Prevent cycles
        if (newParentId && isInSubtree(clientId, newParentId)) return;
        item.parentId = newParentId || null;
        var siblings = siblingsOf(item.parentId).filter(function (i) { return i.clientId !== clientId; });
        item.sortOrder = siblings.reduce(function (m, i) { return Math.max(m, i.sortOrder); }, -1) + 1;
        render({ id: clientId, control: 'parent' });
      }

      function controlName(control, item) {
        var content = allContent.find(function (c) { return c.id === item.contentId; });
        var name = item.label.trim() || (content ? content.title : 'unlabelled item');
        if (control === 'up' || control === 'down') return 'Move ' + name + ' ' + control;
        if (control === 'remove') return 'Remove ' + name;
        return (control === 'label' ? 'Label' : 'Parent') + ' for ' + name;
      }

      function buildParentOptions(excludeClientId, currentParentId) {
        var opts = '<option value=""' + (!currentParentId ? ' selected' : '') + '>Top Level</option>';
        function addLevel(parentId, depth) {
          siblingsOf(parentId).sort(function (a, b) { return a.sortOrder - b.sortOrder; }).forEach(function (item) {
            if (isInSubtree(excludeClientId, item.clientId)) return;
            var prefix = depth > 0 ? Array(depth + 1).join('— ') : '';
            opts += '<option value="' + escapeHtml(item.clientId) + '"' +
              (currentParentId === item.clientId ? ' selected' : '') + '>' +
              escapeHtml(prefix + (item.label || '(unlabelled)')) + '</option>';
            addLevel(item.clientId, depth + 1);
          });
        }
        addLevel(null, 0);
        return opts;
      }

      function renderTree(parentId, depth) {
        var items = siblingsOf(parentId).sort(function (a, b) { return a.sortOrder - b.sortOrder; });
        var html = '';
        items.forEach(function (item, idx) {
          var url = getItemUrl(item);
          var badge = getItemBadge(item);
          var isChild = depth > 0;
          html += '<li class="nav-item' + (isChild ? ' nav-item--child' : '') + '">';
          for (var d = 0; d < depth; d++) html += '<div class="nav-child-indent"></div>';
          html +=
            '<div class="nav-item-controls">' +
              '<button type="button" class="btn-updown" data-focus="up" aria-label="' + escapeHtml(controlName('up', item)) + '" data-dir="-1" data-id="' + escapeHtml(item.clientId) + '"' + (idx === 0 ? ' disabled' : '') + '>&#8679;</button>' +
              '<button type="button" class="btn-updown" data-focus="down" aria-label="' + escapeHtml(controlName('down', item)) + '" data-dir="1" data-id="' + escapeHtml(item.clientId) + '"' + (idx === items.length - 1 ? ' disabled' : '') + '>&#8681;</button>' +
            '</div>' +
            '<div class="nav-item-body">' +
              '<div class="nav-item-meta">' +
                '<span class="nav-badge' + (isChild ? ' nav-badge--child' : '') + '">' + escapeHtml(badge) + '</span>' +
                '<span class="nav-url">' + escapeHtml(url) + '</span>' +
              '</div>' +
              '<div class="nav-item-row">' +
                '<div class="nav-field nav-label-field"><label for="nav-label-' + escapeHtml(item.clientId) + '">Label</label>' +
                  '<input id="nav-label-' + escapeHtml(item.clientId) + '" type="text" class="nav-label-input" data-focus="label" aria-label="' + escapeHtml(controlName('label', item)) + '" data-id="' + escapeHtml(item.clientId) + '" value="' + escapeHtml(item.label) + '" /></div>' +
                '<div class="nav-field"><label for="nav-parent-' + escapeHtml(item.clientId) + '">Parent</label>' +
                  '<select id="nav-parent-' + escapeHtml(item.clientId) + '" class="nav-parent-select" data-focus="parent" aria-label="' + escapeHtml(controlName('parent', item)) + '" data-id="' + escapeHtml(item.clientId) + '">' + buildParentOptions(item.clientId, item.parentId) + '</select></div>' +
                '<button type="button" class="btn-remove" data-focus="remove" aria-label="' + escapeHtml(controlName('remove', item)) + '" data-id="' + escapeHtml(item.clientId) + '">Remove</button>' +
              '</div>' +
            '</div>' +
          '</li>';
          html += renderTree(item.clientId, depth + 1);
        });
        return html;
      }

      function render(focusRequest) {
        var list = document.getElementById('nav-list');
        if (!list) return;
        if (navItems.length === 0) {
          list.innerHTML = '<li class="nav-empty">No items yet. Add pages below.</li>';
        } else {
          list.innerHTML = renderTree(null, 0);
          list.querySelectorAll('.btn-updown').forEach(function (btn) {
            btn.addEventListener('click', function () {
              moveSibling(this.getAttribute('data-id'), parseInt(this.getAttribute('data-dir')));
            });
          });
          list.querySelectorAll('.btn-remove').forEach(function (btn) {
            btn.addEventListener('click', function () { removeItem(this.getAttribute('data-id')); });
          });
          list.querySelectorAll('.nav-label-input').forEach(function (input) {
            input.addEventListener('input', function () { updateLabel(this.getAttribute('data-id'), this.value); });
          });
          list.querySelectorAll('.nav-parent-select').forEach(function (sel) {
            sel.addEventListener('change', function () { changeParent(this.getAttribute('data-id'), this.value || null); });
          });
        }
        syncAddDropdowns();
        if (focusRequest) {
          var controls = Array.from(list.querySelectorAll('[data-id]')).filter(function (control) {
            return control.getAttribute('data-id') === focusRequest.id && !control.disabled;
          });
          var target = controls.find(function (control) { return control.getAttribute('data-focus') === focusRequest.control; });
          // At the first/last position the clicked arrow becomes disabled.
          // Keep focus on the same item's opposite arrow, then its label.
          if (!target && (focusRequest.control === 'up' || focusRequest.control === 'down')) {
            target = controls.find(function (control) { return control.getAttribute('data-focus') === (focusRequest.control === 'up' ? 'down' : 'up'); });
          }
          if (!target) target = controls.find(function (control) { return control.getAttribute('data-focus') === 'label'; });
          if (!target) target = document.getElementById('content-select');
          if (target) target.focus();
        }
      }

      function syncParentSelect() {
        var sel = document.getElementById('parent-select');
        if (!sel) return;
        var selected = sel.value;
        var opts = '<option value="">Top Level</option>';
        function addLevel(parentId, depth) {
          siblingsOf(parentId).sort(function (a, b) { return a.sortOrder - b.sortOrder; }).forEach(function (item) {
            var prefix = depth > 0 ? Array(depth + 1).join('— ') : '';
            opts += '<option value="' + escapeHtml(item.clientId) + '">' + escapeHtml(prefix + (item.label || '(unlabelled)')) + '</option>';
            addLevel(item.clientId, depth + 1);
          });
        }
        addLevel(null, 0);
        sel.innerHTML = opts;
        sel.value = navItems.some(function (item) { return item.clientId === selected; }) ? selected : '';
      }

      function syncAddDropdowns() {
        var contentSel = document.getElementById('content-select');
        var addBtn = document.getElementById('add-btn');
        var usedContentIds = navItems.map(function (n) { return n.contentId; });
        var avail = allContent.filter(function (c) { return usedContentIds.indexOf(c.id) === -1; });
        if (contentSel) {
          var selected = contentSel.value;
          contentSel.innerHTML = avail.length === 0
            ? '<option value="">— all pages in nav —</option>'
            : '<option value="">— select page —</option>' + avail.map(function (c) {
                return '<option value="' + escapeHtml(c.id) + '">' + escapeHtml(c.title) + ' (' + escapeHtml(c.pageType) + ')</option>';
              }).join('');
          contentSel.disabled = avail.length === 0;
          contentSel.value = avail.some(function (item) { return item.id === selected; }) ? selected : '';
        }
        if (addBtn) addBtn.disabled = !contentSel || !contentSel.value;
        syncParentSelect();
      }

      document.getElementById('add-btn').addEventListener('click', function () {
        var parentSel = document.getElementById('parent-select');
        var parentId = parentSel ? parentSel.value || null : null;
        var siblings = siblingsOf(parentId);
        var maxOrder = siblings.reduce(function (m, i) { return Math.max(m, i.sortOrder); }, -1);
        var sel = document.getElementById('content-select');
        var id = sel ? sel.value : '';
        if (!id) return;
        var c = allContent.find(function (c) { return c.id === id; });
        if (!c) return;
        var clientId = newId();
        navItems.push({ clientId: clientId, contentId: id, label: c.title, parentId: parentId, sortOrder: maxOrder + 1 });
        render({ id: clientId, control: 'label' });
      });

      document.getElementById('content-select').addEventListener('change', function () {
        document.getElementById('add-btn').disabled = !this.value;
      });

      document.getElementById('nav-form').addEventListener('submit', function () {
        document.getElementById('nav-items-json').value = JSON.stringify(navItems);
      });

      render();
    })();
  </script>

  <style is:global>
    .nav-section { margin-bottom: 2rem; }

    .nav-panel {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 2rem;
    }

    .add-panel { margin-top: 0.5rem; }

    .panel-title { font-size: 1.05rem; font-weight: 600; color: var(--accent); margin: 0; }
    .panel-desc { font-size: 0.875rem; color: var(--muted); margin: 0; }

    .nav-list { list-style: none; margin: 0; padding: 0; }

    .nav-empty {
      padding: 1.5rem;
      text-align: center;
      color: var(--muted);
      font-size: 0.9rem;
      border: 1px dashed var(--line);
      border-radius: var(--r-md);
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.65rem 0.75rem;
      border-bottom: 1px solid var(--line);
    }
    .nav-item:first-child { border-top: 1px solid var(--line); }

    .nav-item--child {
      background: rgb(from var(--accent) r g b / 3%);
      border-left: 3px solid rgb(from var(--accent) r g b / 25%);
    }

    .nav-child-indent {
      width: 1.5rem;
      flex-shrink: 0;
    }

    .nav-item-controls { display: flex; flex-direction: column; gap: 0.25rem; flex-shrink: 0; }

    .btn-updown {
      display: flex; align-items: center; justify-content: center;
      width: 28px; height: 28px;
      border: 1px solid var(--line); border-radius: var(--r-sm, 6px);
      background: var(--surface); color: var(--text);
      cursor: pointer; font-size: 1.1rem; line-height: 1; padding: 0;
      transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
    }
    .btn-updown:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); background: rgb(from var(--accent) r g b / 8%); }
    .btn-updown:disabled { opacity: 0.3; cursor: default; }

    .nav-item-body { flex: 1; display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }

    .nav-item-meta { display: flex; align-items: center; gap: 0.6rem; }

    .nav-badge {
      font-size: 0.72rem; font-weight: 600; letter-spacing: 0.03em;
      padding: 0.15rem 0.5rem; border-radius: var(--r-sm);
      background: rgb(from var(--accent) r g b / 12%); color: var(--accent);
      border: 1px solid rgb(from var(--accent) r g b / 25%); white-space: nowrap;
      flex-shrink: 0;
    }
    .nav-badge--child {
      background: rgb(from var(--accent) r g b / 6%);
      color: var(--muted);
      border-color: rgb(from var(--accent) r g b / 15%);
    }

    .nav-url { font-size: 0.8rem; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .nav-item-row { display: flex; align-items: flex-end; gap: 0.5rem; }
    .nav-field { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
    .nav-field label { font-size: 0.8rem; font-weight: 600; color: var(--text); }
    .nav-label-field { flex: 1; }
    .add-field { flex: 1; min-width: min(160px, 100%); }
    .nav-section button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    .nav-parent-select {
      width: 160px;
      height: 2.5rem;
      padding: 0 0.7rem;
      box-sizing: border-box;
      border: 1px solid var(--line-strong); border-radius: var(--r-md, 10px);
      background: var(--surface); color: var(--muted);
      font-family: inherit; font-size: 0.82rem; cursor: pointer;
      white-space: nowrap; flex-shrink: 0;
      transition: border-color 0.2s ease, color 0.2s ease;
    }
    .nav-parent-select:focus { outline: 2px solid var(--accent); outline-offset: 2px; border-color: var(--accent); color: var(--text); }

    .nav-label-input {
      width: 100%; min-width: 0;
      height: 2.5rem;
      padding: 0 0.9rem;
      border: 1px solid var(--line-strong); border-radius: var(--r-md, 10px);
      background: var(--surface); color: var(--text);
      font-family: inherit; font-size: 0.95rem;
      box-sizing: border-box;
      transition: border-color 0.2s ease;
    }
    .nav-label-input:focus { outline: 2px solid var(--accent); outline-offset: 2px; border-color: var(--accent); }

    .btn-remove {
      flex-shrink: 0; padding: 0.4rem 0.8rem;
      border: 1px solid rgb(255 61 77 / 40%); border-radius: var(--r-md, 10px);
      background: transparent; color: #ff3d4d;
      cursor: pointer; font-size: 0.875rem; font-family: inherit;
      white-space: nowrap;
      transition: background-color 0.15s ease, border-color 0.15s ease;
    }
    .btn-remove:hover { background: rgb(255 61 77 / 10%); border-color: #ff3d4d; }

    .add-row { display: flex; gap: 0.75rem; align-items: flex-end; flex-wrap: wrap; }

    .field-select {
      width: 100%; min-width: 0;
      padding: 0.75rem 1rem;
      border: 1px solid var(--line-strong); border-radius: var(--r-md, 10px);
      background: var(--surface); color: var(--text);
      font-family: inherit; font-size: 0.95rem; cursor: pointer;
      transition: border-color 0.2s ease;
    }
    .field-select:focus { outline: 2px solid var(--accent); outline-offset: 2px; border-color: var(--accent); }
    .field-select:disabled { opacity: 0.5; cursor: default; }

    .btn-add {
      padding: 0.75rem 1.2rem; white-space: nowrap;
      border: 1px solid var(--accent); border-radius: var(--r-md, 10px);
      background: rgb(from var(--accent) r g b / 10%); color: var(--accent);
      font-family: inherit; font-size: 0.95rem; font-weight: 500;
      cursor: pointer; transition: background-color 0.2s ease;
    }
    .btn-add:hover:not(:disabled) { background: rgb(from var(--accent) r g b / 20%); }
    .btn-add:disabled { opacity: 0.4; cursor: default; }

    .form-actions {
      display: flex; justify-content: flex-end;
      padding: 1.5rem 0; border-top: 1px solid var(--line); margin-top: 0.5rem;
    }

    @media (max-width: 768px) {
      .add-row { flex-direction: column; align-items: stretch; }
      .field-select { width: 100%; }
      .nav-item-row { flex-wrap: wrap; }
      .nav-item-row > .nav-field { flex-basis: 100%; }
      .nav-parent-select { width: 100%; }
    }
  </style>
</AdminLayout>

<style>
  .success-banner {
    padding: 0.75rem 1rem; border-radius: var(--r-md); margin-bottom: 1.5rem;
    background: rgb(168 255 96 / 15%); border: 1px solid rgb(168 255 96 / 40%);
    color: var(--accent-3); font-size: 0.9rem;
  }
  .error-banner {
    padding: 0.75rem 1rem; border-radius: var(--r-md); margin-bottom: 1.5rem;
    background: rgb(255 61 77 / 15%); border: 1px solid rgb(255 61 77 / 40%);
    color: #ff3d4d; font-size: 0.9rem;
  }
</style>
