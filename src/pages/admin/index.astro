---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminLayout from "../../layouts/AdminLayout.astro";
import Card from "../../components/Card.astro";
import FormMessage from "../../components/FormMessage.astro";
import Button from "../../components/Button.astro";
import { isAdmin } from "../../lib/http";

// Admin-only by design (issue #16): only an admin session sees the dashboard.
// A signed-in user with any other role gets a forbidden notice and sign out.
const user = Astro.locals.user;
const loggedIn = isAdmin(user);
const forbidden = Boolean(user) && !loggedIn;
const error = Astro.url.searchParams.get("error");
const signedOutAll = Astro.url.searchParams.get("signedout") === "all";
---

{loggedIn ? (
  <AdminLayout title="Dashboard">
    <section>
      <h2 class="quick-actions-title">Quick Actions</h2>
      <div class="cards-grid">
        <Card icon="plus" title="Create Content" href="/admin/content/new">
          <p>Create a new post, page, or any content type</p>
        </Card>
        <Card icon="file-text" title="Manage Content" href="/admin/content">
          <p>Edit, update, and organize your content</p>
        </Card>
        <Card icon="image" title="Manage Media" href="/admin/media">
          <p>Upload and organize media files</p>
        </Card>
      </div>
    </section>
    <section aria-labelledby="sessions-title">
      <h2 id="sessions-title" class="quick-actions-title">Sessions</h2>
      {error === "sessions" && <FormMessage error>Sessions were not signed out. Try again.</FormMessage>}
      <p class="sessions-note">A session lasts 14 days from sign-in. Signing out all sessions ends every session for this account, including this one.</p>
      <form method="post" action="/api/auth/revoke-all">
        <Button type="submit" variant="danger" icon="log-out">Sign out all sessions</Button>
      </form>
    </section>
  </AdminLayout>
) : forbidden ? (
  <BaseLayout title="Access Denied | Orboro.net" description="This account cannot use the Orboro.net CMS" analytics={false}>
    <section>
      <h1>Access Denied</h1>
      <FormMessage error>This account does not have access to the admin area. Only administrator accounts can sign in here.</FormMessage>
      <form method="post" action="/api/auth/logout">
        <Button type="submit" variant="primary" icon="log-out">Sign out</Button>
      </form>
    </section>
  </BaseLayout>
) : (
  <BaseLayout title="Admin Login | Orboro.net" description="Sign in to Orboro.net CMS" analytics={false}>
    <section>
      <h1>Admin Login</h1>
      {signedOutAll && !error ? <FormMessage>All sessions are signed out. Sign in again to continue.</FormMessage> : null}
      {error
        ? <FormMessage error fields={[{ id: "email", label: "Email" }, { id: "password", label: "Password" }]}>Unable to sign in. Check your email and password and try again.</FormMessage>
        : null}
      <form method="post" action="/api/auth/login">
        <div class="form-group">
          <label for="email">Email</label>
          <input id="email" type="email" name="email" required autocomplete="email" />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input id="password" type="password" name="password" required autocomplete="current-password" />
        </div>
        <Button type="submit" variant="primary">Sign In</Button>
      </form>
    </section>
  </BaseLayout>
)}

<style>
.quick-actions-title { margin: 0 0 1.5rem; }
  .sessions-note { margin: 0 0 1rem; color: var(--muted); }
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .form-group {margin-bottom: 1.5rem;}

  @media (max-width: 768px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
