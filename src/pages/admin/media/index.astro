---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import FormMessage from "../../../components/FormMessage.astro";
import Button from "../../../components/Button.astro";
import Icon from "../../../components/Icon.astro";
import { requireAdmin } from "../../../lib/http";
import { listMedia } from "../../../lib/content";

const access = requireAdmin(Astro);
if (access instanceof Response) return access;
const media = await listMedia(Astro.locals);
const error = Astro.url.searchParams.get("error");
const errorMessages: Record<string, string> = {
  invalid: "Media was not saved. Choose an image or enter an https:// image URL or a site path starting with /, and provide alt text. Alt text is limited to 500 characters and captions to 1,000.",
  "too-large": "The image must be no larger than 10 MB.",
  unsupported: "Use a PNG, JPEG, GIF, WebP, or AVIF image.",
  "upload-failed": "The upload failed. Please try again.",
};
const source = Astro.url.searchParams.get("form");
const errorFields = source === "upload"
  ? [{ id: "file", label: "Image file" }, { id: "uploadAltText", label: "Alt text" }, { id: "uploadCaption", label: "Caption" }]
  : source === "url" ? [{ id: "url", label: "Image URL" }, { id: "altText", label: "Alt text" }] : [];
---

<AdminLayout title="Media">
  {error && errorMessages[error] && <FormMessage error fields={errorFields}>{errorMessages[error]}</FormMessage>}
  {Astro.url.searchParams.has("uploaded") && <p class="form-message" role="status">Image uploaded to the media library.</p>}
  <section class="form-section">
    <h2>Upload Image</h2>
    <form action="/api/media/upload" method="post" enctype="multipart/form-data" class="media-form">
      <div class="form-group">
        <label for="file">Image file</label>
        <input id="file" name="file" type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/avif" required />
        <small>PNG, JPEG, GIF, WebP, or AVIF. Maximum 10 MB.</small>
      </div>
      <div class="form-group">
        <label for="uploadAltText">Alt text</label>
        <input id="uploadAltText" name="altText" type="text" maxlength="500" required placeholder="Describe the image" />
      </div>
      <div class="form-group">
        <label for="uploadCaption">Caption</label>
        <textarea id="uploadCaption" name="caption" rows="2" maxlength="1000" placeholder="Optional caption"></textarea>
      </div>
      <Button type="submit" variant="primary" icon="upload">Upload Image</Button>
    </form>
  </section>

  <section class="form-section">
    <h2>Add Existing Image URL</h2>
    <form action="/api/media/save" method="post" class="media-form">
      <div class="form-group">
        <label for="url">Image URL</label>
        <input id="url" name="url" type="url" maxlength="2048" required placeholder="https://example.com/image.jpg" />
      </div>
      <div class="form-group">
        <label for="altText">Alt text</label>
        <input id="altText" name="altText" type="text" maxlength="500" required placeholder="Description of the image" />
      </div>
      <div class="form-group">
        <label for="caption">Caption</label>
        <textarea id="caption" name="caption" rows="2" maxlength="1000" placeholder="Optional caption for the media"></textarea>
      </div>
      <Button type="submit" variant="primary" icon="upload">
        Add Media Record
      </Button>
    </form>
  </section>

  <section class="library-section">
    <h2>Media Library</h2>
    {media.length === 0 ? (
      <div class="empty-library">
        <Icon name="image" size={48} />
        <p>No media records yet.</p>
        <p class="muted-text">Upload an image or add an existing image URL above.</p>
      </div>
    ) : (
      <div class="media-grid">
        {media.map((item) => (
          <div class="media-card">
            <img class="media-preview" src={item.url} alt={item.altText} loading="lazy" />
            <div class="media-header">
              <strong title={item.altText} class="media-title">{item.altText}</strong>
            </div>
            <div class="media-content">
              {item.caption && (
                <p class="media-caption">{item.caption}</p>
              )}
              <a href={item.url} target="_blank" rel="noreferrer" class="media-url">
                View Image
              </a>
              <p class="media-source">{item.url}</p>
            </div>
            <div class="media-footer">
              <form method="post" action="/api/media/delete" class="delete-form" onsubmit="return confirm('Delete this media record?');">
                <input type="hidden" name="id" value={item.id} />
                <Button type="submit" variant="danger" size="sm" icon="trash-2">
                  Delete
                </Button>
              </form>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>
</AdminLayout>

<style>
  .form-section {
    margin-bottom: 3rem;
  }

  .form-message {
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md, 10px);
    color: var(--text);
  }

  .form-message--error {
    border-color: rgb(255 61 77 / 25%);
  }

  .media-form {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md, 10px);
    padding: 1.5rem;
  }
  .form-group {margin-bottom: 1.5rem;}

  .library-section {
    margin-top: 2rem;
  }

  .empty-library {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 3rem 1rem;
    text-align: center;
    color: var(--muted);
  }

  .empty-library svg {
    opacity: 0.5;
  }

  .empty-library p {
    margin: 0;
  }

  .muted-text {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .media-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-md, 10px);
    overflow: hidden;
    transition: border-color 0.2s ease;
  }

  .media-card:hover {
    border-color: var(--accent);

  }

  .media-preview {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: contain;
    background: var(--surface);
  }

  .media-header {
    padding: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .media-title {
    display: block;
    color: var(--text);
    word-break: break-word;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .media-content {
    flex: 1;
    padding: 1rem;
  }

  .media-caption {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0 0 0.75rem;
    line-height: 1.4;
  }

  .media-url {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .media-source {
    color: var(--muted);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .media-url:hover {
    text-decoration: underline;
  }

  .media-footer {
    padding: 1rem;
    border-top: 1px solid var(--line);
  }

  .delete-form {
    display: block;
    width: 100%;
  }

  .delete-form :global(.btn) {
    width: 100%;
  }

  @media (max-width: 768px) {
    .media-grid {
      grid-template-columns: 1fr;
    }

    .media-form {
      padding: 1rem;
    }
  }
</style>
