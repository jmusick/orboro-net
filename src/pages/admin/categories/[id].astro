---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import CategoryForm from "../../../components/CategoryForm.astro";
import { getCategoryById } from "../../../lib/content";
import { requireAdmin } from "../../../lib/http";

const access = requireAdmin(Astro);
if (access instanceof Response) return access;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect("/admin/categories");
}

const category = await getCategoryById(Astro.locals, id);
if (!category) {
  return Astro.redirect("/admin/categories");
}
---

<AdminLayout title={`Edit ${category.name}`}>
  <CategoryForm category={category} />
</AdminLayout>
