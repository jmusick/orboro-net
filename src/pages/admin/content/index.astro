---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import FormMessage from "../../../components/FormMessage.astro";
import Button from "../../../components/Button.astro";
import Pill from "../../../components/Pill.astro";
import Icon from "../../../components/Icon.astro";
import { requireAdmin } from "../../../lib/http";
import { listAdminContent, listContentCategoryNames } from "../../../lib/content";

const access = requireAdmin(Astro);
if (access instanceof Response) return access;
const content = await listAdminContent(Astro.locals);
const categoryNames = await listContentCategoryNames(Astro.locals);

const getStatusVariant = (status: string) => {
  if (status === "published") return "success";
  if (status === "draft") return "warning";
  return "default";
};

const getStatusIcon = (status: string) => {
  if (status === "published") return "check";
  if (status === "draft") return "alert-circle";
  return "file-text";
};
---

<AdminLayout title="Content">
  {Astro.url.searchParams.get("error") === "invalid" && <FormMessage error>Unable to complete the content request. Select the content and try again.</FormMessage>}
  <section class="content-header">
    <Button href="/admin/content/new" variant="primary" icon="plus">
      Create New Content
    </Button>
  </section>

  {content.length === 0 ? (
    <section class="empty-state">
      <Icon name="file-text" size={48} />
      <h3>No content yet</h3>
      <p>Create your first post or page to get started</p>
      <Button href="/admin/content/new" variant="primary">Create Content</Button>
    </section>
  ) : (
    <section class="content-table-section">
      <div class="filter-bar">
        <div class="filter-field filter-field--search">
          <label for="filter-search">Search content</label>
          <input
            id="filter-search"
            type="search"
            class="filter-input"
            placeholder="Title, slug, or category…"
            autocomplete="off"
          />
        </div>
        <div class="filter-field">
          <label for="filter-type">Content type</label>
          <select id="filter-type" class="filter-select">
            <option value="">All types</option>
            <option value="post">Post</option>
            <option value="page">Page</option>
          </select>
        </div>
        <div class="filter-field">
          <label for="filter-status">Status</label>
          <select id="filter-status" class="filter-select">
            <option value="">All statuses</option>
            <option value="published">Published</option>
            <option value="draft">Draft</option>
          </select>
        </div>
        <span id="filter-count" class="filter-count" role="status" aria-atomic="true"></span>
      </div>

      <div class="content-table-wrapper">
        <table class="content-table" id="content-table">
          <thead>
            <tr>
              {[
                ["title", "Title"],
                ["type", "Type"],
                ["categories", "Categories"],
                ["status", "Status"],
                ["slug", "Slug"],
              ].map(([column, label]) => (
                <th scope="col" class="sortable" data-col={column}>
                  <button type="button" class="sort-button" aria-label={`Sort by ${label.toLowerCase()}`}>
                    {label} <span class="sort-icon" aria-hidden="true"></span>
                  </button>
                </th>
              ))}
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody id="content-tbody">
            {content.map((item) => {
              const cats = categoryNames[item.id] ?? [];
              return (
                <tr
                  data-title={item.title.toLowerCase()}
                  data-type={item.pageType}
                  data-status={item.status}
                  data-slug={item.slug}
                  data-categories={cats.map(c => c.toLowerCase()).join(",")}
                >
                  <td class="cell-title"><strong>{item.title}</strong></td>
                  <td><Pill variant="info" size="sm">{item.pageType}</Pill></td>
                  <td>
                    <div class="cell-categories">
                      {cats.length > 0
                        ? cats.map((name) => <Pill variant="info" size="sm">{name}</Pill>)
                        : <span class="cell-empty">—</span>
                      }
                    </div>
                  </td>
                  <td>
                    <Pill variant={getStatusVariant(item.status)} size="sm" icon={getStatusIcon(item.status)}>
                      {item.status}
                    </Pill>
                  </td>
                  <td><code class="mono">{item.slug}</code></td>
                  <td class="cell-actions">
                    <Button href={`/admin/content/${item.id}`} variant="secondary" size="sm" icon="edit">
                      Edit
                    </Button>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <p id="no-results" class="no-results" hidden>No content matches your filters.</p>
      </div>
    </section>
  )}

  <script is:inline nonce={Astro.locals.nonce}>
    (function () {
      var searchEl = document.getElementById('filter-search');
      var typeEl = document.getElementById('filter-type');
      var statusEl = document.getElementById('filter-status');
      var countEl = document.getElementById('filter-count');
      var tbody = document.getElementById('content-tbody');
      var noResults = document.getElementById('no-results');
      var headers = document.querySelectorAll('.content-table th.sortable');

      if (!tbody) return;

      var allRows = Array.from(tbody.querySelectorAll('tr'));
      var sortCol = '';
      var sortDir = 'asc';

      function getVal(row, col) {
        return (row.getAttribute('data-' + col) || '').toLowerCase();
      }

      function applyFilterSort() {
        var search = (searchEl ? searchEl.value : '').toLowerCase().trim();
        var typeVal = typeEl ? typeEl.value : '';
        var statusVal = statusEl ? statusEl.value : '';

        var visible = allRows.filter(function (row) {
          if (search && !(getVal(row, 'title').includes(search) || getVal(row, 'slug').includes(search) || getVal(row, 'categories').includes(search))) return false;
          if (typeVal && getVal(row, 'type') !== typeVal) return false;
          if (statusVal && getVal(row, 'status') !== statusVal) return false;
          return true;
        });

        if (sortCol) {
          visible.sort(function (a, b) {
            var av = getVal(a, sortCol);
            var bv = getVal(b, sortCol);
            return sortDir === 'asc' ? av.localeCompare(bv) : bv.localeCompare(av);
          });
        }

        allRows.forEach(function (r) { r.style.display = 'none'; });
        visible.forEach(function (r) {
          r.style.display = '';
          tbody.appendChild(r);
        });

        if (countEl) {
          var message = visible.length === allRows.length
            ? allRows.length + ' items'
            : visible.length + ' of ' + allRows.length + ' items';
          if (countEl.textContent !== message) countEl.textContent = message;
        }
        if (noResults) noResults.hidden = visible.length !== 0;
      }

      function updateSortIcons() {
        headers.forEach(function (th) {
          var col = th.getAttribute('data-col');
          if (col === sortCol) {
            th.setAttribute('aria-sort', sortDir === 'asc' ? 'ascending' : 'descending');
          } else {
            th.removeAttribute('aria-sort');
          }
          var icon = th.querySelector('.sort-icon');
          if (!icon) return;
          icon.textContent = col === sortCol ? (sortDir === 'asc' ? ' ↑' : ' ↓') : '';
        });
      }

      headers.forEach(function (th) {
        var button = th.querySelector('.sort-button');
        if (!button) return;
        button.addEventListener('click', function () {
          var col = th.getAttribute('data-col');
          if (sortCol === col) {
            sortDir = sortDir === 'asc' ? 'desc' : 'asc';
          } else {
            sortCol = col;
            sortDir = 'asc';
          }
          updateSortIcons();
          applyFilterSort();
        });
      });

      if (searchEl) searchEl.addEventListener('input', applyFilterSort);
      if (typeEl) typeEl.addEventListener('change', applyFilterSort);
      if (statusEl) statusEl.addEventListener('change', applyFilterSort);

      applyFilterSort();
    })();
  </script>
</AdminLayout>

<style>
  .content-header {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 1.5rem;
  }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 3rem 1rem;
    text-align: center;
    color: var(--muted);
  }

  .empty-state h3 { margin: 0; color: var(--text); font-size: 1.3rem; }
  .empty-state p { margin: 0 0 1rem; }
  .empty-state svg { opacity: 0.5; }

  .filter-bar {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .filter-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .filter-field--search {
    flex: 1;
    min-width: min(200px, 100%);
  }
  .filter-field label { font-size: 0.82rem; font-weight: 600; }

  .filter-input {
    width: 100%;
    min-width: 0;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md, 10px);
    background: var(--surface);
    color: var(--text);
    font-family: inherit;
    font-size: 0.9rem;
    transition: border-color 0.2s ease;
  }
  .filter-input:focus { outline: 2px solid var(--accent); outline-offset: 2px; border-color: var(--accent); }

  .filter-select {
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md, 10px);
    background: var(--surface);
    color: var(--text);
    font-family: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }
  .filter-select:focus { outline: 2px solid var(--accent); outline-offset: 2px; border-color: var(--accent); }

  .filter-count { font-size: 0.82rem; color: var(--muted); white-space: nowrap; margin-left: auto; padding-bottom: 0.6rem; }

  .content-table-wrapper { overflow-x: auto; }

  .content-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }

  .content-table th {
    padding: 0.75rem;
    text-align: left;
    font-weight: 600;
    color: var(--accent);
    border-bottom: 2px solid var(--line);
    background:var(--surface-2);
    white-space: nowrap;
  }

  .content-table th.sortable { padding: 0; }
  .sort-button {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    width: 100%;
    min-height: 44px;
    padding: 0.75rem;
    border: 0;
    border-radius: var(--r-sm, 6px);
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .sort-button:hover {
    color: var(--text);
    background-color: rgb(from var(--accent) r g b / 10%);
  }
  .sort-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -3px;
  }

  .sort-icon { font-style: normal; color: var(--accent); font-size: 0.85rem; }

  .content-table td {
    padding: 1rem 0.75rem;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    vertical-align: middle;
  }

  .content-table tbody tr:hover {
    background:var(--surface-2);
  }

  .cell-title { font-weight: 500; }

  .cell-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }

  .cell-empty { color: var(--muted); }
  .cell-actions { text-align: right; white-space: nowrap; }

  .mono {
    font-family: "Courier New", monospace;
    font-size: 0.85rem;
    color: var(--muted);
    background: rgb(0 0 0 / 20%);
    padding: 0.25rem 0.5rem;
    border-radius: var(--r-sm);
  }

  .no-results {
    text-align: center;
    color: var(--muted);
    padding: 2rem 0;
    font-size: 0.95rem;
  }
</style>
