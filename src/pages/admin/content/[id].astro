---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ContentForm from "../../../components/ContentForm.astro";
import { getContentById, listCategories, getContentCategoryIds } from "../../../lib/content";
import { requireAdmin } from "../../../lib/http";

const access = requireAdmin(Astro);
if (access instanceof Response) return access;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect("/admin/content");
}

const content = await getContentById(Astro.locals, id);
if (!content) {
  return Astro.redirect("/admin/content");
}

const categories = await listCategories(Astro.locals);
const selectedCategoryIds = await getContentCategoryIds(Astro.locals, id);
---

<AdminLayout title={`Edit ${content.title}`}>
  <ContentForm content={content} categories={categories} selectedCategoryIds={selectedCategoryIds} />
</AdminLayout>
