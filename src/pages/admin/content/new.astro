---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import easyMdeUrl from "easymde/dist/easymde.min.js?url";
import FormMessage from "../../../components/FormMessage.astro";
import HomepageFeatureFields from "../../../components/HomepageFeatureFields.astro";
import Button from "../../../components/Button.astro";
import { ensureRole } from "../../../lib/http";
import { listCategories } from "../../../lib/content";

const access = ensureRole(Astro, ["admin", "editor", "author"]);
if (access instanceof Response) return access;
const categories = await listCategories(Astro.locals);
---

<AdminLayout title="Create Content">
  {Astro.url.searchParams.get("error") === "invalid" && <FormMessage error fields={[{ id: "title", label: "Title" }, { id: "slug", label: "Slug" }, { id: "markdown", label: "Markdown" }]}>Content was not saved. Provide a title, a valid slug and Markdown. Re-enter any unsaved changes before saving again.</FormMessage>}
  {Astro.url.searchParams.get("error") === "homepage" && <FormMessage error fields={[{ id: "homepageGroup", label: "Group" }, { id: "homepageOrder", label: "Display order" }, { id: "homepageDescription", label: "Card description" }]}>Content was not saved. Choose a homepage group, an order from 0 to 9999, and a description of at most 240 characters. Re-enter any unsaved changes before saving again.</FormMessage>}
  <section class="editor-section">
    <form method="post" action="/api/content/save" id="content-form" class="content-editor">
      <div class="form-row">
        <div class="form-group">
          <label for="title">Title</label>
          <input id="title" type="text" name="title" required placeholder="Enter content title" />
        </div>
        <div class="form-group">
          <label for="slug">Slug</label>
          <input id="slug" type="text" name="slug" required placeholder="my-post" />
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="pageType">Page Type</label>
          <select id="pageType" name="pageType">
            <option value="post">Post</option>
            <option value="page">Page</option>
          </select>
        </div>
        <div class="form-group">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="draft">Draft</option>
            <option value="published">Published</option>
          </select>
        </div>
      </div>

      <div class="form-group full">
        <label for="featuredImageUrl">Featured Image URL</label>
        <input id="featuredImageUrl" type="text" name="featuredImageUrl" placeholder="/images/example.jpg or https://example.com/image.jpg" />
      </div>

      <HomepageFeatureFields />

      <div class="form-group full">
        <label id="markdown-label" for="markdown">Markdown Content</label>
        <textarea id="markdown" name="markdown" rows="20" placeholder="Write your content in Markdown..."></textarea>
      </div>

      {categories.length > 0 && (
        <div class="form-group full">
          <label>Categories</label>
          <div class="category-checkboxes">
            {categories.map((cat) => (
              <label class="category-label">
                <input type="checkbox" name="categoryId" value={cat.id} />
                <span>{cat.name}</span>
              </label>
            ))}
          </div>
        </div>
      )}

      <div class="form-actions">
        <Button type="submit" variant="primary" icon="check">
          Publish Content
        </Button>
      </div>
    </form>
  </section>

  <script is:inline src={easyMdeUrl}></script>
  <script>
    import "../../../scripts/admin-editor.ts";
  </script>

  <style>
    .editor-section {
      margin-bottom: 2rem;
    }

    .content-editor {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .form-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1rem;
    }

    .form-actions {
      display: flex;
      justify-content: flex-end;
      padding: 1.5rem 0;
      border-top: 1px solid var(--line);
    }

    .category-checkboxes {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .category-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
    }

    @media (max-width: 768px) {
      .form-row { grid-template-columns: 1fr; }
    }
  </style>
</AdminLayout>
