---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ContentForm from "../../../components/ContentForm.astro";
import { requireAdmin } from "../../../lib/http";
import { listCategories } from "../../../lib/content";

const access = requireAdmin(Astro);
if (access instanceof Response) return access;
const categories = await listCategories(Astro.locals);
---

<AdminLayout title="Create Content">
  <ContentForm categories={categories} />
</AdminLayout>
