---
import AccountShell from "../../components/AccountShell.astro";
import Button from "../../components/Button.astro";
import FormMessage from "../../components/FormMessage.astro";
import { ensureDB } from "../../lib/db";
import { peekMemberToken } from "../../lib/members";
import { PASSWORD_HINT, memberMessage } from "../../lib/member-messages";

const params = Astro.url.searchParams;
const token = params.get("token") ?? "";
const code = params.get("error");
const valid = token ? Boolean(await peekMemberToken(ensureDB(Astro.locals), token, "reset")) : false;
const error = memberMessage(code);
---

<AccountShell title="Choose a new password" description="Choose a new password for your Orboro.net account.">
  {valid ? (
    <>
      {error && <FormMessage error fields={[{ id: "password", label: "New password" }]}>{error}</FormMessage>}
      <form method="post" action="/api/members/reset">
        <input type="hidden" name="token" value={token} />
        <div class="form-group">
          <label for="password">New password</label>
          <input id="password" name="password" type="password" required minlength="15" maxlength="512" autocomplete="new-password" aria-describedby="password-hint" />
          <p id="password-hint" class="account__hint">{PASSWORD_HINT} Saving signs you out on every device.</p>
        </div>
        <Button type="submit" variant="primary">Save password</Button>
      </form>
    </>
  ) : (
    <FormMessage error>{memberMessage("expired")}</FormMessage>
  )}
  <p class="account__links"><a href="/account/forgot">Request a new link</a><a href="/account/login">Sign in</a></p>
</AccountShell>
