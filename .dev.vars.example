# Copy to .dev.vars for local development (gitignored). These are Cloudflare's
# published Turnstile test keys: the widget always passes and Siteverify always
# succeeds. https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
