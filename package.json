{
  "name": "orboro",
  "type": "module",
  "version": "1.46.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro build && wrangler dev --ip 127.0.0.1 --port 8787",
    "dev:astro": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro",
    "check": "astro check",
    "test:markdown": "node --experimental-strip-types --test tests/markdown.test.ts",
    "test:dates": "node --experimental-strip-types --test tests/dates.test.ts",
    "test:login-throttle": "node --experimental-strip-types --test tests/login-throttle.test.ts",
    "test:sessions": "node --experimental-strip-types --test tests/sessions.test.ts",
    "test:feed": "node --experimental-strip-types --test tests/feed.test.ts",
    "test:json": "node --experimental-strip-types --test tests/json.test.ts",
    "test:bookmarks": "node --experimental-strip-types --test tests/bookmarks-data.test.ts",
    "test:cache-policy": "node --experimental-strip-types --test tests/cache-policy.test.ts",
    "test:content-writes": "node --experimental-strip-types --test tests/content-writes.test.ts",
    "test:request-limits": "node --experimental-strip-types --test tests/request-limits.test.ts",
    "test:consent": "node --test tests/consent.test.mjs",
    "test:csp": "node --test tests/csp-navigation.test.mjs",
    "data:assisted-combat": "node scripts/generate-assisted-combat-data.mjs",
    "data:midnight-s2-interrupts": "node scripts/generate-midnight-s2-interrupt-data.mjs",
    "data:spec-icons": "node scripts/fetch-spec-icons.mjs",
    "media:migrate": "node scripts/migrate-content-images.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "admin:reset-password": "node scripts/reset-password.mjs",
    "sessions:revoke": "node scripts/revoke-sessions.mjs",
    "cf:types": "wrangler types",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "check:styles": "node scripts/check-styles.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "astro": "^7.3.6",
    "easymde": "2.21.0",
    "font-awesome": "4.7.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.19.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.145.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.4": true,
    "sharp@0.35.5": true,
    "workerd@1.20260926.1": true,
    "workerd@1.20260930.2": true,
    "workerd@1.20261006.1": true
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
